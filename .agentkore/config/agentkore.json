{
  "name": "AgentKore",
  "version": "2.0.0",
  "mode": "fast",
  "default_agent": "executor",
  "max_repair_loops": 2,
  "docs_output": "./docs",
  "memory_path": "./memory",
  "runtime_path": ".agentkore/runtime",
  "native_opencode_skills_path": ".opencode/skills",
  "agentkore_source_skills_path": ".agentkore/hermes/skills",
  "always_loaded_skills": [
    "agent-contract",
    "agent-flow",
    "change-test-loop",
    "git-workflow",
    "security"
  ],
  "common_support_skills": [
    "debugging",
    "testing-strategy",
    "code-review",
    "repo-discovery"
  ],
  "optional_skill_policy": {
    "simple_task_max": 5,
    "enterprise_task_max": 9,
    "docker_only_when_needed": true,
    "load_only_needed": true
  },
  "recommended_flows": {
    "simple_code": [
      "agent-contract",
      "git-workflow",
      "relevant-stack-skill",
      "change-test-loop",
      "code-review"
    ],
    "enterprise_feature": [
      "doc-system",
      "ak-elicit",
      "ak-party",
      "prd-lite",
      "story-slicing",
      "prd-to-tasks",
      "session-manager",
      "task-executor"
    ],
    "proxy_llm": [
      "local-llm-reliability",
      "proxy-enforcer",
      "proxy-tool-calling",
      "go-lang",
      "testing-strategy",
      "change-test-loop"
    ],
    "release": [
      "git-workflow",
      "code-review",
      "design-check",
      "security",
      "release-checklist"
    ],
    "skill_system_update": [
      "skill-registry-maintainer",
      "release-checklist"
    ],
    "shell_scripting": [
      "bash-shell",
      "testing-strategy",
      "change-test-loop"
    ],
    "ui_change": [
      "ui",
      "ui-strategy",
      "framework-ui-skill",
      "testing-strategy",
      "change-test-loop",
      "design-check",
      "code-review"
    ]
  },
  "documentation_policy": {
    "check_existing_docs_before_create": true,
    "link_related_docs": true,
    "avoid_duplicate_docs": true,
    "docs_root": "docs"
  },
  "memory_policy": {
    "write_only_durable": true,
    "minimum_score_to_write": 7,
    "score_dimensions": [
      "durability",
      "reuse",
      "non_obviousness",
      "risk_if_forgotten"
    ],
    "memory_files": [
      "memory/index.md",
      "memory/patterns.md",
      "memory/decisions.md",
      "memory/mistakes.md",
      "memory/commands.md"
    ]
  },
  "optional_skills_path": ".opencode/optional-skills",
  "skills": [
    "agent-contract",
    "agent-flow",
    "bash-shell",
    "change-test-loop",
    "code-review",
    "debugging",
    "doc-system",
    "fast-bmad",
    "git-workflow",
    "memory-management",
    "repo-discovery",
    "security",
    "session-manager",
    "state-orchestrator",
    "task-executor",
    "testing-strategy"
  ]
}
