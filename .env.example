# ── Hermes Cortex — .env.example ──
# Copy this to .env and fill in your secrets. Never commit .env.
#
# LLM cron provider/model (Luke 2026-09-08): unpinned crons use PRIMARY
# (LLM_CRON_MODEL + LLM_CRON_PROVIDER); the operator-owned fallback chain lives
# in ~/.hermes/config.yaml `fallback_providers` (set via `hermes config set`),
# NOT in this file. To change the fleet's cron model, edit LLM_CRON_MODEL +
# LLM_CRON_PROVIDER only.
#
#   Provider values: opencode-free | openrouter | deepseek | opencode-zen

LLM_CRON_MODEL=deepseek-v4-flash-free
LLM_CRON_PROVIDER=opencode-free

# ── AGENT IDENTITY / ROLE ──
IS_ORCHESTRATOR=true
IS_SERVER=false

# ── EMBEDDING MODEL (used by mycortex, skills, memory) ──
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── DOMAIN / BASE URL ──
CORTEX_DOMAIN=your-domain.com
CORTEX_BASE=https://your-domain.com

# ── MODEL CONFIG ──
JUDGE_MODEL=qwen2.5:3b
CODING_MODEL=deepseek-v4-flash
CREATIVE_MODEL=deepseek-v4-flash

# ── AGENT BUS (PGMQ) ──
CORTEX_BUS_URL=https://your-domain.com:13004
CORTEX_BUS_FALLBACK_URL=https://your-domain.com:14004
CORTEX_BASIC_AUTH=your-username:your-password
AGENT_NAME=your-agent-name

# Postgres connection (shared mycortex-postgres)
CORTEX_BUS_PG_HOST=127.0.0.1
CORTEX_BUS_PG_PORT=15432
CORTEX_BUS_PG_DB=mycortex
CORTEX_BUS_PG_USER=mycortex
CORTEX_BUS_PG_PASS=change-me

# Auth token (matches bus.tokens row)
CORTEX_BUS_TOKEN=hbus_your_token_here

# ── CRON / SCHEDULER ──
HERMES_CRON_TIMEOUT=600
HERMES_TIMEZONE=Asia/Seoul

# ── ORCHESTRATOR HEALTH URLS (comma-separated) ──
ORCH_HEALTH_URLS=https://your-domain.com:13007/health,https://your-domain.com:13004/health
BACKUP_ORCH_HEALTH_URLS=https://your-domain.com:14004/health
