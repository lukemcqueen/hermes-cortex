# ── Hermes Cortex — Single .env source of truth (cortex layer) ──
# ~/.hermes-cortex/cortex-bus.conf symlinks here — run
#   bash ~/.hermes-cortex/scripts/consolidate-env.sh   (idempotent)
# ⚠ ~/.hermes/.env is HERMES-OWNED (provider keys, Telegram, browser/
#   terminal settings) — never symlink or merge it into this file.
# Gitignored. Protect: chmod 600.
#   1. Script defaults
#   2. This file (.env)
#   3. Runtime env vars (export VAR=value before running)
#
# ⚠ PYTHON 3.12+ REQUIRED — macOS ships Python 3.9 which breaks PEP 604
#    (`str | None` syntax). All Hermes scripts use `#!/usr/bin/env python3.12`.
#    Install via: brew install python@3.12  # or uv / pyenv
#    Canonical path: ~/.local/bin/python3.12 (uv-managed)

# =============================================================================
# AGENT IDENTITY
# =============================================================================
# IANA timezone for cron outputs (hermes_tz.py + hermes_time.py read this).
# Every cron timestamp derives from this env var — never hardcode KST/UTC in
# a script. Default when unset: system local time.
# HERMES_TIMEZONE="Asia/Seoul"
#
# Your external health endpoint URL, e.g. https://yourdomain.com:13007/health
# Orchestrator pollers use this to verify your agent is externally reachable.
# CORTEX_HEALTH_URL=
#
# The agent bus API endpoint for agent-to-agent messaging.
# CORTEX_BUS_URL="https://example.com:13004"
#
# Bus auth credentials: "agent-name:password"
# Each agent has a unique password. Get yours from the fleet admin.
# CORTEX_BUS_AUTH="moses:your-unique-password"
#
# Your agent name — must match the username in CORTEX_BUS_AUTH.
# AGENT_NAME="moses"
#
# Is this agent an orchestrator? Orchestrators run cross-agent health polling,
# team message flagging, inbox remediation, and soul-refinement crons.
# Set to 'true' ONLY on orchestrator hosts (Moses primary, Esther backup).
# IS_ORCHESTRATOR=false
#
# Telegram delivery for LLM-driven cron jobs (agent-bus, agent-auto-remediate, etc.)

# =============================================================================
# MODELS (read by hermes_models.py)
# =============================================================================
# LLM-as-Judge model — used by llm-judge-scorer, model-health-watchdog
# JUDGE_MODEL=qwen2.5:3b
#
# Embedding model — used by mycortex, session-cache, loop-scorer, offline_code
# EMBEDDING_MODEL=nomic-embed-text:v1.5
#
# Code generation model — used by offline_code gen
# CODING_MODEL=qwen2.5:7b
#
# Creative/general text generation model — reserved
# CREATIVE_MODEL=qwen2.5:3b
#
# System-wide default model for agent sessions
# DEFAULT_MODEL=deepseek-v4-flash

# =============================================================================
# CRON MODEL/PROVIDER (read by install-crons.sh)
# =============================================================================
# LLM-driven cron jobs (agent-inbox, agent-auto-remediate, etc.)
# use these to pin their model. Set to whatever main model you run.
# LLM_CRON_MODEL=deepseek-v4-flash
# LLM_CRON_PROVIDER=deepseek
#
# LLM cron fallback chain (read by install-fallback-providers.py) —
# tried in order when the pinned cron model fails (rate-limit, 5xx,
# connection errors). Remove a tier by leaving its vars empty.
# LLM_CRON_FALLBACK1_MODEL=deepseek/deepseek-v4-flash
# LLM_CRON_FALLBACK1_PROVIDER=openrouter
# LLM_CRON_FALLBACK2_MODEL=deepseek-v4-flash
# LLM_CRON_FALLBACK2_PROVIDER=deepseek
# LLM_CRON_FALLBACK3_MODEL=deepseek-v4-flash
# LLM_CRON_FALLBACK3_PROVIDER=opencode-zen
#
# LLM cron inactivity timeout in seconds — applied to the Hermes gateway
# by install-gateway-cron-timeout.sh on every cortex-update (systemd
# drop-in on Linux, ~/.hermes/.env on macOS). Fleet default 300s; upstream
# Hermes default is 600s (a hung provider API call idles 10 min before the
# cron is killed). 0 = unlimited. Requires a gateway restart to activate.
# HERMES_CRON_TIMEOUT=300
#
# Local-only crons (qwen on Ollama) use these — typically the local model.
# LOCAL_CRON_MODEL=qwen2.5:3b
# LOCAL_CRON_PROVIDER=custom:ollama-local

# =============================================================================
# CORTEX INFRASTRUCTURE
# =============================================================================
# Cortex deployment home directory — scripts, state, logs, services
# CORTEX_DEPLOY_HOME="${HOME}/.hermes-cortex"
# CORTEX_SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# CORTEX_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# CORTEX_NGINX_PORT_PREFIX=13

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# OPENROUTER_API_KEY=sk-or-...
# OPENCODE_ZEN_API_KEY=sk-QVq...
# DEEPSEEK_API_KEY=sk-...

# =============================================================================
# LANGKFUSE (LLM Observability) — Optional
# =============================================================================
# HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
# HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
# HERMES_LANGFUSE_BASE_URL=http://localhost:3000
# HERMES_LANGFUSE_ENV=local
# HERMES_LANGFUSE_RELEASE=v1
# HERMES_LANGFUSE_SAMPLE_RATE=1.0
