# ── Hermes Cortex — Single Environment Configuration Example ──
# Copy to: .env (gitignored) and fill in your values.
# ⚠ NOTE: ~/.hermes/.env is Hermes Agent's own config — never touched by Cortex.
#
# 🔒 Protect: chmod 600 .env
#
# Source order (last wins):
#   1. Script defaults
#   2. This file (.env)
#   3. Runtime env vars (export VAR=value before running)

# =============================================================================
# AGENT IDENTITY
# =============================================================================
# Is this agent an orchestrator? Orchestrators run cross-agent health polling,
# team message flagging, inbox remediation, and soul-refinement crons.
# Set to 'true' ONLY on orchestrator hosts (Moses primary, Esther backup).
# IS_ORCHESTRATOR=false
#
# The inbox API endpoint for agent-to-agent messaging.
# CORTEX_INBOX_URL="https://bus.example.org:13004"
#
# Basic Auth credentials: "agent-name:password"
# Each agent has a unique password. Get yours from the fleet admin.
# CORTEX_INBOX_AUTH="moses:your-unique-password"
#
# Your agent name — must match the username in CORTEX_INBOX_AUTH.
# AGENT_NAME="moses"

# =============================================================================
# MODELS (read by hermes_models.py)
# =============================================================================
# LLM-as-Judge model — used by llm-judge-scorer, model-health-watchdog
# JUDGE_MODEL=qwen2.5-coder:3b
#
# Embedding model — used by gbrain, session-cache, loop-scorer, offline_code
# EMBEDDING_MODEL=nomic-embed-text:v1.5
#
# Code generation model — used by offline_code gen
# CODING_MODEL=qwen2.5-coder:7b
#
# Creative/general text generation model — reserved
# CREATIVE_MODEL=qwen2.5-coder:3b
#
# System-wide default model for agent sessions
# DEFAULT_MODEL=deepseek-v4-flash

# =============================================================================
# CORTEX INFRASTRUCTURE
# =============================================================================
# CORTEX_SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# CORTEX_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# CORTEX_NGINX_PORT_PREFIX=13

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# OPENROUTER_API_KEY=sk-or-...
# OPENCODE_ZEN_API_KEY=sk-QVq...
# DEEPSEEK_API_KEY=sk-...

# =============================================================================
# LANGKFUSE (LLM Observability) — Optional
# =============================================================================
# HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
# HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
# HERMES_LANGFUSE_BASE_URL=http://localhost:3000
# HERMES_LANGFUSE_ENV=local
# HERMES_LANGFUSE_RELEASE=v1
# HERMES_LANGFUSE_SAMPLE_RATE=1.0

# =============================================================================
# TELEGRAM INTEGRATION
# =============================================================================
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=...
# TELEGRAM_HOME_CHANNEL=...

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_TIMEOUT=60
# TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# BROWSER TOOL
# =============================================================================
# BROWSERBASE_PROXIES=true
# BROWSERBASE_ADVANCED_STEALTH=false
# BROWSER_SESSION_TIMEOUT=300
# BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
# WEB_TOOLS_DEBUG=false
# VISION_TOOLS_DEBUG=false
# MOA_TOOLS_DEBUG=false
# IMAGE_TOOLS_DEBUG=false
