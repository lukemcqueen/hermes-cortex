# ── Hermes Cortex — .env.example ──
# Copy this to .env and fill in your secrets. Never commit .env.
#
# LLM cron model — mechanism (verified against hermes-agent cron/jobs.py, 2026-10-02):
#   An UNPINNED cron job follows the MAIN agent model (`hermes model`, i.e.
#   ~/.hermes/config.yaml `model.default` + its resolved provider). The pair below
#   does NOT set that model — nothing in Hermes reads it at fire time.
#   What this pair DOES do: the HC installer consumes it, and when BOTH values
#   are set, install-crons.sh pin_cron_model() returns early and applies NO
#   per-cron pin. Jobs therefore stay unpinned — and a future manifest sync
#   cannot re-pin them to a dead model.
#   So: set the MAIN model to change what crons actually run on; set this pair to
#   keep the installer from re-pinning. The operator fallback chain is separate
#   (~/.hermes/config.yaml `fallback_providers`, via `hermes config set`).
#
#   Provider values: openrouter | deepseek | opencode-zen | nous
#   Model id form is PROVIDER-SPECIFIC: `deepseek/deepseek-v4.1-flash` on
#   openrouter, `deepseek-v4.1-flash` on the native deepseek provider.
#
# ⚠️ DO NOT pin a free tier. `opencode-free` / `deepseek-v4-flash-free`
# no longer resolve: the pin SURVIVES, the run silently falls through to a PAID
# route, and the job still reports status: ok. The only visible signal is the
# delivery header line "⚠️ Provider fallback: <free> unavailable; using <paid>".
# Procedure to move a host onto a resolvable chain:
#   docs/runbooks/cron-model-chain-repoint.md

LLM_CRON_MODEL=deepseek/deepseek-v4.1-flash
LLM_CRON_PROVIDER=openrouter

# ── AGENT IDENTITY / ROLE ──
IS_ORCHESTRATOR=true
IS_SERVER=false

# ── EMBEDDING MODEL (used by mycortex, skills, memory) ──
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ── DOMAIN / BASE URL ──
CORTEX_DOMAIN=your-domain.com
CORTEX_BASE=https://your-domain.com

# ── MODEL CONFIG ──
JUDGE_MODEL=qwen2.5:3b
CODING_MODEL=qwen2.5:3b
CREATIVE_MODEL=deepseek-v4-flash

# ── AGENT BUS (PGMQ) ──
CORTEX_BUS_URL=https://your-domain.com:13004
CORTEX_BUS_FALLBACK_URL=https://your-domain.com:14004
CORTEX_BASIC_AUTH=your-username:your-password
AGENT_NAME=your-agent-name

# Postgres connection (shared mycortex-postgres)
CORTEX_BUS_PG_HOST=127.0.0.1
CORTEX_BUS_PG_PORT=15432
CORTEX_BUS_PG_DB=mycortex
CORTEX_BUS_PG_USER=mycortex
CORTEX_BUS_PG_PASS=change-me

# Auth token (matches bus.tokens row)
CORTEX_BUS_TOKEN=hbus_your_token_here

# ── CRON / SCHEDULER ──
HERMES_CRON_TIMEOUT=600
HERMES_TIMEZONE=Asia/Seoul

# ── REVIEW TRIAGE — System One judge for the adversarial close-gate ──
# OPTIONAL and OFF by default. Leave ADVERSARIAL_TRIAGE_MODEL empty and the gate
# behaves exactly as before: the reviewer's severities stand, nothing is relaxed.
# The judge must speak /v1/systemone (typed questions in, typed answers out) —
# a chat-completions model, local or remote, CANNOT serve it. See
# docs/runbooks/review-triage-jev.md
ADVERSARIAL_TRIAGE_MODEL=

# Credential for the Jev judge. NAME ONLY here — put the value in the gitignored
# env file, never in this example and never in the repo.
# TYPESAFE_API_KEY=
# Optional override for the judgment client's provider/routing config.
# JUDGMENT_CONFIG_PATH=

# ── ADVERSARIAL REVIEW — who verifies a complex change before it can close ──
# Backend: llm (default) or agent. Both are fail-closed: an unreachable or
# misconfigured reviewer REFUSES the close, it never passes it.
ADVERSARIAL_REVIEW_BACKEND=llm
# llm backend: keep the reviewer model DIFFERENT from the worker's.
ADVERSARIAL_REVIEWER_MODEL=deepseek/deepseek-v4-pro
# Point at a local/self-hosted endpoint to review offline (default OpenRouter).
# ADVERSARIAL_REVIEW_BASE_URL=
# NAME of the credential to read. Set it and it is honoured strictly — the
# reviewer never silently falls back to a different credential. Never the value.
# ADVERSARIAL_REVIEW_API_KEY_ENV=
# agent backend: the coding-agent CLI, with the review prompt on STDIN. The
# command MUST put the agent in its read-only mode — a reviewer that can write
# can edit until its own objections disappear.
# ADVERSARIAL_REVIEW_AGENT_CMD=
# The agent's identity; refused if it matches the change's git author (self-review).
# ADVERSARIAL_REVIEW_AGENT_NAME=
# ADVERSARIAL_REVIEW_AGENT_TIMEOUT=900

# ── ORCHESTRATOR HEALTH URLS (comma-separated) ──
ORCH_HEALTH_URLS=https://your-domain.com:13007/health,https://your-domain.com:13004/health
BACKUP_ORCH_HEALTH_URLS=https://your-domain.com:14004/health
