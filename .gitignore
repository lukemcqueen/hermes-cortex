# Git filter-repo artifacts
# Agent infrastructure
# (.hermes-cortex/ ignore rules REMOVED 2026-10-07: the Cortex repo must not
#  carry that directory — inside ~/hermes-cortex it shadowed the runtime dir
#  ~/.hermes-cortex and made a governance marker look like repo state. Deliberately
#  NOT ignored now, so a recurrence shows up as untracked instead of hiding.)
IMPROVEMENTS.md

# Agent registry (PII — real hostnames, URLs, IPs)
agent-registry.json
# Use ops/install/deploy/agent-registry.json.example as the template
.governance-*.json
/deploy/
# Per-machine allow list — NEVER commit (PII: real client IPs live only
# at /etc/nginx/allow-ips-manual.conf on each host)
allow-ips-manual.conf
# ops/scripts/ is fully tracked — every script in here is intentional
# and worth sharing with the fleet. New scripts are auto-tracked.
# (Previously used per-file whitelist; fell out of sync too often.)
/runtime
# (The in-repo governance lock marker was REMOVED 2026-10-07 — locks are
#  runtime-only in ~/.hermes-cortex/state/, and nothing may write governance
#  state inside a repository. Its ignore rule went with it.)
private-data/
# mycortex DB backups (e.g. pre-migration dumps) — large, PII-heavy, never commit
ops/services/mycortex/backups/
laptop/
