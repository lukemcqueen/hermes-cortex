.agentkore/
.opencode/
.web-cache/
*.cache.db

# Personal/local artifacts — PII protection
cleanup_repos.sh
patches/
# Moral Architecture source PDF — carries the author's real name (kept local)
docs/reference/moral-architecture/*.pdf

# Secrets and credentials
.env
.env.local
.env.*
*.env
!.env.example
*.pem
*.key
**/creds/**
**/credentials*
inbox.conf

# Hermes state databases (session data, not config)
.hermes/
state.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Memory files (gitignored per brain source — root level too for safety)
MEMORY.md
USER.md

# Logs
logs/
*.log
*.pid

# Auth secrets
.htpasswd

# Secrets and credentials (extended)
*secret*
*credential*
*cred*
*token*
*.p12
# Negate our own scripts that legitimately contain "secret"
!ops/scripts/secret-leak-detector.sh
!ops/scripts/secret-leak-watchdog.py
# Negate our own code that legitimately contains "token" (not a secret file)
!ops/scripts/token-expiry-alert.py
# The live-token guard. `*token*` above silently untracked it: the file existed in
# the working tree (so cortex-update.sh deployed it and the tests read it), but it
# was never IN git — a fresh clone would have the unit's ExecStartPre pointing at a
# file that does not exist, and the unit would refuse to start everywhere else.
# A source file whose NAME trips the secret patterns needs an explicit negation.
!ops/scripts/cortex_gateway/guard_distinct_token.py
# Negate our own skills that legitimately contain "credential" or "secret"
!**/secure-credential-handling/**
!**/credential-leak-response/
!**/credential-leak-response/**
!ops/scripts/agent/agent-worker.py
!ops/scripts/agent/install-worker.sh
!ops/scripts/orch-bus/orch-bus-depth-watchdog.sh
!ops/scripts/orch-bus/orch-bus-audit-watchdog.py
!ops/scripts/orch-bus/orch-bus-forwarder.py
!ops/scripts/orch-bus/orch-bus-confirmation-poller.py
!ops/scripts/orch-bus/orch-bus-confirmation-alert.sh
!ops/scripts/orch-bus/orch-bus-recover-timeouts.sh
!ops/scripts/orch-bus/orch-bus-workflow-inspector.py
!ops/scripts/orch-bus/orch-bus-sensor.py

