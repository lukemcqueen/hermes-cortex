#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  post-merge — Auto-deploy after every git pull/merge
#
#  Fires after git pull (fetch + merge) completes. Runs
#  cortex-update.sh to sync all deployed files
#  to the new HEAD. This is the structural fix for "I pulled
#  but forgot to deploy."
#
#  Skips if SKIP_POST_MERGE=1 is set (emergency bypass).
# ─────────────────────────────────────────────────────────────
set -euo pipefail

if [[ "${SKIP_POST_MERGE:-}" == "1" ]]; then
  echo "⚠️  post-merge: SKIP_POST_MERGE=1 — skipping cortex-update"
  exit 0
fi

# Scope guard (2026-08-20): core.hooksPath is GLOBAL, so this hook fires in
# EVERY git repo on the host — including oh-my-zsh's own auto-update repo.
# A full cortex-update deploy for an unrelated repo pull is wasteful and
# confusing (observed: oh-my-zsh update triggered a cortex-update run).
# Only auto-deploy when the pull/merge happened inside ~/hermes-cortex.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
if [[ "${REPO_ROOT}" != "${HOME}/hermes-cortex" ]]; then
  exit 0
fi

UPDATE_SCRIPT="${HOME}/hermes-cortex/ops/scripts/cortex-update.sh"
if [[ ! -f "$UPDATE_SCRIPT" ]]; then
  echo "⚠️  post-merge: cortex-update.sh not found at $UPDATE_SCRIPT"
  echo "   Clone the repo first: cd ~ && git clone https://github.com/fleet-operator/hermes-cortex"
  exit 0
fi

echo "━━━ post-merge: auto-deploying to match new HEAD ━━━"
bash "$UPDATE_SCRIPT" 2>&1 | sed 's/^/   /'
echo "━━━ post-merge: deploy complete ━━━"
