#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  pre-commit-score — Git pre-commit hook (secondary logger)
#
#  SECONDARY LOGGER: the MCP server (loop-gov-mcp.py) is the
#  primary enforcement layer. It blocks write tools without an
#  active governance lock at the Hermes tool level — this hook
#  is redundant for enforcement.
#
#  What this hook adds: automatic score-cycle logging on every
#  git commit so cycles appear in the DB without manual effort.
#
#  The governance-lock check below (Level 3) is a secondary
#  safety net — the MCP server already blocks writes without
#  a lock, so this should never fire for an MCP-connected agent.
#
#  Set SKIP_SCORE=1 to bypass has been removed — no bypass flags.
#
#  Installed by: install-score-hook.sh
#  Requires: score-cycle in PATH, loop-governance tools
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# ── Guard: git hooksPath must point to our hooks ─────────────
# If core.hooksPath is unset or wrong, this pre-commit hook
# wouldn't even be running — but we check anyway for safety.
# The REAL danger is when hooksPath points elsewhere entirely,
# meaning NO governance hooks run at all. We verify at the
# start of every commit that the hooks directory is ours.
EXPECTED_HOOKS="${HOME}/.hermes-cortex/hooks"
ACTUAL_HOOKS=$(git config --get core.hooksPath 2>/dev/null || echo "")
if [[ -z "$ACTUAL_HOOKS" ]]; then
    echo ""
    echo "❌  core.hooksPath is not set — git hooks are NOT running for this repo!"
    echo "    Set it: git config core.hooksPath '${EXPECTED_HOOKS}'"
    echo ""
    exit 1
fi
# Normalize paths for comparison (resolve ~ and relative paths)
ACTUAL_HOOKS_RESOLVED=$(cd "$ACTUAL_HOOKS" 2>/dev/null && pwd || echo "$ACTUAL_HOOKS")
if [[ "$ACTUAL_HOOKS_RESOLVED" != "$EXPECTED_HOOKS" ]]; then
    echo ""
    echo "❌  core.hooksPath points to '${ACTUAL_HOOKS_RESOLVED}' instead of '${EXPECTED_HOOKS}'"
    echo "    Governance hooks are NOT installed for this repo."
    echo "    Fix: git config core.hooksPath '${EXPECTED_HOOKS}'"
    echo ""
    exit 1
fi

# ── Pre-commit sentinel for no-verify detection ─────────────
# Written at hook start. Post-commit hook checks for this file.
# If missing, --no-verify was used and the event gets logged.
SENTINEL="${GIT_DIR:-.git}/.pre-commit-ran"
LOGDIR="${HOME}/.hermes-cortex/state"
NO_VERIFY_LOG="${LOGDIR}/no-verify-log.json"
mkdir -p "$LOGDIR"
touch "$SENTINEL"

# ── Enforcer plugin presence check (C5) ─────────────────────
# If the governance enforcer plugin is not installed, block commit.
ENFORCER_PLUGIN="${HOME}/.hermes/plugins/governance-enforcer/__init__.py"
if [[ ! -f "$ENFORCER_PLUGIN" ]]; then
  echo ""
  echo "❌  Governance enforcer plugin not found at:"
  echo "    ${ENFORCER_PLUGIN}"
  echo "    Install it: ln -sf ~/hermes-cortex/plugins/hermes-governance-enforcer ~/.hermes/plugins/"
  echo "    Then run: /reset to load the plugin."
  echo ""
  exit 1
fi

# ── Orchestrator-only paths guard ──────────────────────────
# Only orchestrator agents (moses, esther) may modify these paths.
# Non-orchestrators: commit changes from an orchestrator agent instead.

# ── Orchestrator-only paths guard ──────────────────────────
# blocked_ips.add is a cumulative shared blocklist — APPEND only.
# Reject commits that shrink it (fewer IPs than HEAD).
BLOCKED_IPS="deploy/nginx/blocked_ips.add"
if git diff --cached --name-only -- "$BLOCKED_IPS" 2>/dev/null | grep -q "$BLOCKED_IPS"; then
  OLD_COUNT=$(git show HEAD:"$BLOCKED_IPS" 2>/dev/null | grep -cP '^\d+\.\d+\.\d+\.\d+' || echo 0)
  NEW_COUNT=$(grep -cP '^\d+\.\d+\.\d+\.\d+' "$BLOCKED_IPS" 2>/dev/null || echo 0)
  if [ "$NEW_COUNT" -lt "$OLD_COUNT" ] 2>/dev/null; then
    echo ""
    echo "❌  blocked_ips.add shrank from ${OLD_COUNT} to ${NEW_COUNT} IPs."
    echo "    This is a SHARED cumulative blocklist maintained by ALL agents."
    echo "    APPEND your IPs — never replace the file."
    echo "    No bypass flags — fix the issue or use --no-verify (not recommended)."
    echo ""
    exit 1
  fi
fi

# ── Governance: AGENTS.md section check ───────────────────
# ~/.hermes/AGENTS.md is the agent's operating rules. It must exist
# and contain the core numbered rules (like SOUL.md marker check).
# Not byte-exact — each repo may have project-specific additions.
AGENTS_LOCAL="${HOME}/.hermes/AGENTS.md"
if [[ ! -f "$AGENTS_LOCAL" ]]; then
  echo ""
  echo "❌  ~/.hermes/AGENTS.md not found."
  echo "    Governance: the agent's operating rules are missing."
  echo "    Run: cp AGENTS.md ~/.hermes/AGENTS.md"
  echo "    No bypass flags — governance is non-negotiable."
  echo ""
  exit 1
fi
if [[ -f "AGENTS.md" ]]; then
  LOCAL_RULES=$(grep -cE '^[0-9]+\. \*\*' "$AGENTS_LOCAL" 2>/dev/null || echo 0)
  REPO_RULES=$(grep -cE '^[0-9]+\. \*\*' "AGENTS.md" 2>/dev/null || echo 0)
  THRESHOLD=$((REPO_RULES - 5))
  if [[ "$LOCAL_RULES" -lt "$THRESHOLD" ]] 2>/dev/null; then
    MISSING=$((REPO_RULES - LOCAL_RULES))
    echo ""
    echo "❌  ~/.hermes/AGENTS.md is missing ${MISSING} numbered rule(s)"
    echo "    Local has ${LOCAL_RULES}, template has ${REPO_RULES}"
    echo "    Run: cp AGENTS.md ~/.hermes/AGENTS.md"
    echo "    No bypass flags — governance is non-negotiable."
    echo ""
    exit 1
  fi
fi

# ── Governance: SOUL.md template sync ────────────────────
# ~/.hermes/SOUL.md is the agent's identity document. It must stay
# in sync with the canonical template in docs/templates/SOUL.md.
SOUL_LOCAL="${HOME}/.hermes/SOUL.md"
SOUL_TEMPLATE="docs/templates/SOUL.md"
if [[ -f "$SOUL_LOCAL" ]] && [[ -f "$SOUL_TEMPLATE" ]]; then
  # Extract bold markers from the Behavioral Principles section of both
  SOUL_LOCAL_MARKERS=$(sed -n '/## Behavioral Principles/,/^## /p' "$SOUL_LOCAL" | grep -oE '\*\*[^*]+\*\*' | sort -u)
  SOUL_TMPL_MARKERS=$(sed -n '/## Behavioral Principles/,/^## /p' "$SOUL_TEMPLATE" | grep -oE '\*\*[^*]+\*\*' | sort -u)
  LOCAL_COUNT=$(wc -l <<< "$SOUL_LOCAL_MARKERS")
  TMPL_COUNT=$(wc -l <<< "$SOUL_TMPL_MARKERS")
  # Allow small variance for agent-specific bullets (non-orchestrators skip "Orchestrator" marker)
  THRESHOLD=$((TMPL_COUNT - 3))
  if [[ "$LOCAL_COUNT" -lt "$THRESHOLD" ]] 2>/dev/null; then
    MISSING=$((TMPL_COUNT - LOCAL_COUNT))
    echo ""
    echo "❌  ~/.hermes/SOUL.md is out of sync with the template."
    echo "    Template has ~${TMPL_COUNT} principle markers, local has ~${LOCAL_COUNT} — ${MISSING} missing."
    echo "    Governance: identity document must follow the template."
    echo "    Run: python3 ~/hermes-cortex/ops/scripts/manage/soul-merge.py"
    echo "    No bypass flags — governance is non-negotiable."
    echo ""
    exit 1
  fi
fi

# ── Reflexion gate: verify skill_view('reflexion-check') was called this session ──
# Query the session DB for proof the agent actually loaded the skill — not just
# a file-presence check. The governance lock carries the session_id.
if ! python3 -c "
import sqlite3, json, os, glob, sys

state_db = os.path.expanduser('~/.hermes/state.db')
gov_dir = os.path.expanduser('~/.hermes-cortex/state')

# Determine repo slug (same logic as governance lock check below)
try:
    repo_slug = os.path.basename(os.popen('git rev-parse --show-toplevel 2>/dev/null').read().strip() or 'generic')
except:
    repo_slug = 'generic'

# Find the governance lock for this repo to get session_id
session_id = None
lock_files = glob.glob(os.path.join(gov_dir, '.governance-*.json'))
for f in lock_files:
    try:
        d = json.load(open(f))
        if d.get('repo_slug') == repo_slug:
            session_id = d.get('session_id')
            break
    except (OSError, json.JSONDecodeError):
        continue

if not session_id:
    # Fallback: no lock file — check the most recent non-cron session
    if os.path.exists(state_db):
        try:
            conn = sqlite3.connect(state_db)
            rows = conn.execute('''SELECT id FROM sessions WHERE id NOT LIKE 'cron_%' ORDER BY started_at DESC LIMIT 3''').fetchall()
            conn.close()
            for (sid,) in rows:
                # Check each recent session for reflexion-check
                conn2 = sqlite3.connect(state_db)
                hits = conn2.execute('''SELECT 1 FROM messages WHERE session_id=? AND tool_name=? AND role=? AND content LIKE ? LIMIT 1''',
                    (sid, 'skill_view', 'tool', '%reflexion-check%')).fetchone()
                conn2.close()
                if hits:
                    session_id = sid
                    break
        except:
            session_id = None  # Acceptable: fallback exhausted, will fail at gate below

if not session_id:
    print('NO-LOCK')
    sys.exit(1)

# Query the messages table for skill_view('reflexion-check') in this session
if not os.path.exists(state_db):
    print('NO-DB')
    sys.exit(1)

try:
    conn = sqlite3.connect(state_db)
    rows = conn.execute(
        'SELECT content FROM messages WHERE session_id=? AND tool_name=? AND role=? ORDER BY id',
        (session_id, 'skill_view', 'tool')
    ).fetchall()
    conn.close()
except sqlite3.OperationalError:
    print('NO-DB')
    sys.exit(1)

for (content_json,) in rows:
    try:
        d = json.loads(content_json)
        if d.get('name') == 'reflexion-check':
            sys.exit(0)
    except (json.JSONDecodeError, AttributeError):
        continue

sys.exit(1)
"; then
  echo ""
  echo "❌  Reflexion check not completed."
  echo "    You must actually run the reflexion-check skill before committing:"
  echo "      skill_view(name='reflexion-check')"
  echo "    Answer all 6 questions, then commit."
  echo "    No bypass flags — use --no-verify only in emergencies."
  echo ""
  exit 1
fi

# ── Level 3: Governance lock check (secondary - MCP handles this) ───
# The MCP server (loop-gov-mcp.py) already blocks write tools without
# a lock. This check is a secondary safety net for direct-git operations.
# Agent must call begin_change() before making changes.
#
# Lock files are SESSION-SCOPED: .governance-sess_<id>.json (named by
# session_id). Multiple sessions can each hold a valid lock. The repo_slug
# is stored INSIDE the lock file's content, not in the filename.
# This mirrors the MCP plugin's _has_governance_lock() and _derive_slug().
GOVERNANCE_STATE_DIR="${HOME}/.hermes-cortex/state"
REPO_SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo 'generic')" 2>/dev/null || echo 'generic')

# Scan all .governance-*.json files for one matching this repo
LOCK_FOUND=0
if [[ -d "$GOVERNANCE_STATE_DIR" ]]; then
  for lock_file in "$GOVERNANCE_STATE_DIR"/.governance-*.json; do
    [[ -f "$lock_file" ]] || continue
    FILE_SLUG=$(python3 -c "
import json
try:
    d = json.load(open('$lock_file'))
    slug = d.get('repo_slug')
    # Legacy locks (no repo_slug) accepted for upgrade compat
    print(slug if slug else '$REPO_SLUG')
except:
    print('')
" 2>/dev/null)
    if [[ "$FILE_SLUG" == "$REPO_SLUG" ]]; then
      LOCK_FOUND=1
      break
    fi
  done
fi

if [[ "$LOCK_FOUND" -ne 1 ]]; then
  # No session-scoped lock for this repo — block with help message
  echo ""
  echo "❌  No active governance session."
  echo "    You must call begin_change(task_id, description) before making changes."
  echo "    Run: mcp_loop_governance_begin_change(task_id=\"fix-xyz\", description=\"...\")"
  echo ""
  echo "    💡 Lock files are SESSION-SCOPED (.governance-sess_<id>.json) and"
  echo "       matched by the repo_slug field inside the file. cd into the repo"
  echo "       before calling begin_change() so it picks up the correct repo slug."
  echo ""
  echo "    Use begin_change() in the correct repo directory."
  echo ""
  exit 1
fi

# ── Level 2: AGENTS.md core requirements check via agents-doc-audit.py ──
AUDIT_SCRIPT=""
for candidate in agents-doc-audit.py ~/.hermes-cortex/scripts/agents-doc-audit.py ~/.local/bin/agents-doc-audit.py "$(git rev-parse --show-toplevel 2>/dev/null || echo '')/ops/scripts/agents-doc-audit.py"; do
  if [[ -f "$candidate" ]]; then
    AUDIT_SCRIPT="$candidate"
    break
  fi
done
if [[ -z "$AUDIT_SCRIPT" ]]; then
  # Fallback: find it in hermes-cortex repo
  for base in ~/hermes-cortex ~/HermesCortex ~/cortex; do
    candidate="$base/ops/scripts/agents-doc-audit.py"
    if [[ -f "$candidate" ]]; then
      AUDIT_SCRIPT="$candidate"
      break
    fi
  done
fi
if [[ -n "$AUDIT_SCRIPT" ]]; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$REPO_ROOT" ]]; then
    AGENTS_OUTPUT=$(python3 "$AUDIT_SCRIPT" --repo "$REPO_ROOT" --json 2>&1 || true)
    AGENTS_EXIT=$?
    if [[ "$AGENTS_EXIT" -eq 2 ]]; then
      echo "❌  AGENTS.md not found at repo root. Create one before committing."
      echo "    See ~/hermes-cortex/AGENTS.md as template."
      exit 1
    fi
    if [[ "$AGENTS_EXIT" -eq 1 ]]; then
      echo "$AGENTS_OUTPUT" | python3 -c "
import json, sys
try:
    data = json.loads(sys.stdin.read())
    missing = data.get('missing_sections', [])
    if missing:
        print('⚠️  AGENTS.md missing required sections:')
        for s in missing:
            print(f'   - {s}')
        print('   No bypass flags — fix the issue.')
except Exception:
    print('⚠️  AGENTS.md check failed (non-parseable output)')
    print(sys.stdin.read())
" 2>/dev/null || echo "$AGENTS_OUTPUT"
      exit 1
    fi
  fi
fi

# ── Score the current commit ────────────────────────────────────
# (Lock lifecycle managed by MCP server via begin/end_change)

# Find score-cycle — try PATH, then common locations (resolve to full path)
SCORE_CYCLE=""
for candidate in score-cycle ~/.local/bin/score-cycle "$HOME/.local/bin/score-cycle"; do
  if resolved=$(command -v "$candidate" 2>/dev/null); then
    SCORE_CYCLE="$resolved"
    break
  fi
done

# If score-cycle doesn't exist, warn once per install
if [[ -z "$SCORE_CYCLE" ]]; then
  echo "⚠  score-cycle not found — skipping old scoring"
  echo "   Current governance is MCP-based (begin_change → cycle_query → feedback_accept → end_change)"
  exit 0
fi

# Collect staged files (skip deletions, binary files, lock files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -v '\.lock$' \
  | grep -v 'package-lock\.json\|yarn\.lock\|pnpm-lock\.yaml' \
  | grep -v '\.svg$\|\.png$\|\.jpg$\|\.jpeg$\|\.gif$\|\.ico$' \
  || true)

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# Get the parent commit hash for --prev-code-file
PARENT_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "0000000")

# Get test pass rate — try full suite first, fall back to targeted
PASS_PCT=100
if [[ -f "pytest.ini" ]] || ls pytest.ini setup.cfg pyproject.toml 2>/dev/null | grep -q .; then
  PYTEST_OUTPUT=$(python3 -m pytest tests/ -q --tb=no 2>/dev/null || true)
  if echo "$PYTEST_OUTPUT" | grep -qE "^[0-9]+ passed"; then
    TOTAL=$(echo "$PYTEST_OUTPUT" | grep -oE '^[0-9]+' | head -1)
    FAILED=$(echo "$PYTEST_OUTPUT" | grep -oE '[0-9]+ failed' | grep -oE '^[0-9]+' || echo "0")
    if [[ "$TOTAL" -gt 0 ]]; then
      PASS_PCT=$(( (TOTAL - FAILED) * 100 / TOTAL ))
    fi
  fi
fi

# Collect ALL staged files into a single code file for scoring
# (instead of only scoring the first file — which hides N-1 changes)
ALL_CODE_FILE=$(mktemp)
for staged_file in $STAGED_FILES; do
  echo "# --- $staged_file ---" >> "$ALL_CODE_FILE"
  git show :"$staged_file" 2>/dev/null >> "$ALL_CODE_FILE" || true
  echo "" >> "$ALL_CODE_FILE"
done

# Try to get the previous versions for progress comparison
PREV_FILE=$(mktemp)
if [[ "$PARENT_COMMIT" != "0000000" ]]; then
  for staged_file in $STAGED_FILES; do
    echo "# --- $staged_file ---" >> "$PREV_FILE"
    git show "$PARENT_COMMIT:$staged_file" >> "$PREV_FILE" 2>/dev/null || true
    echo "" >> "$PREV_FILE"
  done
fi

# Run score-cycle — prefer 3.12+ for PEP 604 syntax support
PYTHON_BIN="python3"
for py in ~/.local/bin/python3.12 ~/.pyenv/versions/3.14.*/bin/python3 ~/.pyenv/versions/3.13.*/bin/python3 ~/.pyenv/versions/3.12.*/bin/python3; do
  if [[ -x "$py" ]]; then
    PYTHON_BIN="$py"
    break
  fi
done

# ── GAP CLOSED: Remove silent score-cycle failure ─────────────
# Before 2026-07-07: stderr was hidden (2>/dev/null) and a failed
# score-cycle silently fell through to echo '{"decision":"LOOP"}',
# letting bypassed-governance commits go through unnoticed.
# 
# Now: stderr is visible, and on failure the commit warns + proceeds
# but does NOT fake a cycle. The user sees what happened.
#
# Known Hermes enforcement regex gap: the ^ anchor on git commit
# only catches standalone commands. Compound commands bypass it:
#   cd x && git commit      ← bypasses
#   SKIP_SCORE=1 ← this no longer works — removed.  
# Run git commit standalone to trigger the enforcement check.
# ────────────────────────────────────────────────────────────────

# Build task id from repo + branch + commit message (descriptive, unique)
REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo 'unknown')")
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')
COMMIT_MSG=$(head -1 "$(git rev-parse --git-dir 2>/dev/null)/COMMIT_EDITMSG" 2>/dev/null || echo "update")
MSG_SLUG=$(echo "$COMMIT_MSG" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//' | head -c 48)
TASK_ID="precommit-${REPO_NAME}-${BRANCH}/${MSG_SLUG}"

# Auto-increment cycle number per task (so repeated commits with same message get cycles 1,2,3...)
DB_PATH="$HOME/.hermes-cortex/data/loop-governance.db"
PREV_CYCLE=$(python3 -c "
import sqlite3, os
db = os.path.expanduser('$DB_PATH')
if os.path.exists(db):
    try:
        c = sqlite3.connect(db)
        r = c.execute('SELECT MAX(cycle_num) FROM loop_cycles WHERE task_id = ?', ('$TASK_ID',)).fetchone()
        c.close()
        print(r[0] or 0)
    except:
        print(0)
else:
    print(0)
" 2>/dev/null || echo "0")
CYCLE_NUM=$((PREV_CYCLE + 1))

SCORE_STDERR=$(mktemp)
SCORE_OUTPUT=$(timeout 30 "$PYTHON_BIN" "$SCORE_CYCLE" \
  --task "$TASK_ID" \
  --cycle "$CYCLE_NUM" \
  --code-file "$ALL_CODE_FILE" \
  --prev-code-file "$PREV_FILE" \
  --pass-pct "$PASS_PCT" \
  --json 2>"$SCORE_STDERR") || {
  # score-cycle failed — show BOTH stderr AND stdout (DB failure writes to stdout)
  echo ""
  echo "❌  score-cycle FAILED — no governance cycle was recorded!" >&2
  echo "" >&2
  echo "    STDOUT (error details):" >&2
  echo "$SCORE_OUTPUT" | sed 's/^/      /' >&2
  echo "" >&2
  if [[ -s "$SCORE_STDERR" ]]; then
    echo "    STDERR:" >&2
    sed 's/^/      /' "$SCORE_STDERR" >&2
    echo "" >&2
  fi
  echo "    Without a cycle record, this commit is invisible to governance." >&2
  echo "    Fix the DB issue to proceed with governance." >&2
  echo "" >&2
  rm -f "$SCORE_STDERR"
  SCORE_OUTPUT='{"decision":"LOOP","note":"score-cycle failed — no cycle logged"}'
}
rm -f "$SCORE_STDERR"

rm -f "$PREV_FILE" "$ALL_CODE_FILE"

# ── Documentation audit (mandatory, no bypass) ──────────
if [[ -f "$HOME/hermes-cortex/ops/scripts/pre-commit-doc-audit.sh" ]]; then
  bash "$HOME/hermes-cortex/ops/scripts/pre-commit-doc-audit.sh"
fi

# ── Secret leak detection (mandatory, no bypass) ─────────
if [[ -f "$HOME/hermes-cortex/ops/scripts/secret-leak-detector.sh" ]]; then
  bash "$HOME/hermes-cortex/ops/scripts/secret-leak-detector.sh"
fi

# ── Change validation (mandatory, no bypass) ────────────
if [[ -f "$REPO_ROOT/ops/scripts/change-validate.sh" ]]; then
  bash "$REPO_ROOT/ops/scripts/change-validate.sh"
fi

# ── Orchestrator-only paths guard ──────────────────────────
# Only orchestrator agents (moses, esther) may modify these paths.
# Non-orchestrators: commit changes from an orchestrator agent instead.
ORCHESTRATOR_ONLY_PATHS=(
  "^docs/templates/"
  # "^profiles/personal/agent-profiles/"  # removed from repo (commit d43e776)
  "^AGENTS\.md$"
  "^ops/scripts/pre-commit-score$"
  "^ops/scripts/pre-push-pull$"
  "^ops/scripts/install/"
  "^ops/scripts/cortex-update\.sh$"
  "^ops/scripts/manage/cortex_doctor/"
  "^skills/"
  "^tests/"
  "test_.*\.py$"
  ".*_test\.py$"
  ".*_spec\.py$"
)
BLOCKED=""
for pattern in "${ORCHESTRATOR_ONLY_PATHS[@]}"; do
  if echo "$STAGED_FILES" | grep -qE "$pattern"; then
    BLOCKED="$pattern"
    break
  fi
done
if [[ -n "$BLOCKED" ]]; then
  # Determine agent type by hostname only — env var is self-reported and bypassable
  HOST="$(hostname -s 2>/dev/null || echo 'unknown')"
  case "$HOST" in
    moses|esther) AGENT_TYPE="orchestrator" ;;
    *) AGENT_TYPE="server" ;;
  esac
  if [[ "$AGENT_TYPE" != "orchestrator" ]]; then
    echo ""
    echo "❌  Orchestrator-only path blocked: ${BLOCKED}"
    echo "    Detected agent type: ${AGENT_TYPE:-unknown}"
    echo "    Non-orchestrator agents may NOT modify these paths:"
    echo "      docs/templates/  profiles/  AGENTS.md"
    echo "      pre-commit-score  install/  cortex-update.sh"
    echo "      cortex_doctor/  skills/  tests/"
    echo "    Commit this change from an orchestrator agent (moses or esther)."
    echo ""
    exit 1
  fi
fi

# ── Adversarial scan (staged files only, A2 level) ──────────
# HARD GATE: blocks commit if critical/high findings exist. No bypass.
ADVERSARIAL_SCRIPT="$REPO_ROOT/ops/scripts/quality/adversarial-verify.py"
if [[ -f "$ADVERSARIAL_SCRIPT" ]]; then
  ADV_FAILED=0
  ADV_SCANNED=0
  while IFS= read -r adv_file; do
    ADV_SCANNED=$((ADV_SCANNED + 1))
    if ! ADV_OUTPUT=$(python3 "$ADVERSARIAL_SCRIPT" --file "$REPO_ROOT/$adv_file" --level A2 --gate 2>&1); then
          ADV_FAILED=$((ADV_FAILED + 1))
          echo "   ❌  $adv_file:" | sed 's/^/   /'
          echo "$ADV_OUTPUT" | grep -E "❌|FAIL|CRITICAL|Medium|High" | head -5 | sed 's/^/      /' || true
        fi
  done <<< "$STAGED_FILES"
  if [[ "$ADV_FAILED" -gt 0 ]]; then
    echo ""
    echo "❌  Adversarial scan blocked: ${ADV_FAILED} file(s) have findings."
    echo "    Fix the findings before committing."
    echo ""
    exit 1
  fi
  if [[ "$ADV_SCANNED" -gt 0 ]]; then
    echo "✅  Adversarial verify: passed on ${ADV_SCANNED} file(s)"
  fi
fi

# Check decision — LOOP is normal for first cycle, STOP means done
DECISION=$(echo "$SCORE_OUTPUT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('decision','LOOP'))" 2>/dev/null || echo "LOOP")

echo "📊  score-cycle: $DECISION (task=$TASK_ID, pass-pct=$PASS_PCT)"

# Only BLOCK on unrecoverable errors — LOOP/STOP/MOVE_ON all pass
if [[ "$DECISION" == "ERROR" ]]; then
  echo ""
  echo "❌  score-cycle failed — commit blocked."
  echo "    Fix the issue — no bypass flags available."
  exit 1
fi
