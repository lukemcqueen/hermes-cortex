# ─────────────────────────────────────────────────────────────
#  hermes-services.env — nginx deploy configuration
#  Server: cisnet03 (mwi-stage.koscap.or.kr)
# ─────────────────────────────────────────────────────────────
#  Source this file before running hermes-services-apply.py,
#  hermes-security-apply, or cortex-update.sh to override
#  auto-detected SSL certificate paths and nginx port prefix.
# ─────────────────────────────────────────────────────────────

# ── SSL Certificates ────────────────────────────────────────
# Let's Encrypt cert for mp-stage.koscap.or.kr
# (nginx reads these as root — certs are in root-only dir)
CORTEX_SSL_CERT_PATH=/etc/letsencrypt/live/mp-stage.koscap.or.kr/fullchain.pem
CORTEX_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/mp-stage.koscap.or.kr/privkey.pem

# Domain for Let's Encrypt lookup
CORTEX_SSL_DOMAIN=mp-stage.koscap.or.kr

# ── Port Prefix ─────────────────────────────────────────────
# Template ships as 13xxx (this server uses 13xxx)
CORTEX_NGINX_PORT_PREFIX=13

# ── Repo Path ───────────────────────────────────────────────
CORTEX_REPO=$HOME/hermes-cortex
