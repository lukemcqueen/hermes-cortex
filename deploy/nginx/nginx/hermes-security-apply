#!/bin/bash
set -euo pipefail

SRC="/home/luke/hermes-cortex/deploy/nginx"
BACKUP="/etc/hermes-cortex-backups/$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BACKUP"

cp /etc/nginx/hermes-services.conf "$BACKUP/" 2>/dev/null || true
cp /etc/nginx/hermes-zone-defs.conf "$BACKUP/" 2>/dev/null || true
cp /etc/nginx/blocked_ips.conf "$BACKUP/" 2>/dev/null || true
cp /etc/fail2ban/filter.d/nginx-badbots.conf "$BACKUP/" 2>/dev/null || true

install -o root -g root -m 0644 "$SRC/hermes-services.conf" /etc/nginx/hermes-services.conf
install -o root -g root -m 0644 "$SRC/hermes-zone-defs.conf" /etc/nginx/hermes-zone-defs.conf

# Remove duplicate include
awk '!seen[$0]++' /etc/nginx/hermes-services.conf > /tmp/hermes-services.conf
install -o root -g root -m 0644 /tmp/hermes-services.conf /etc/nginx/hermes-services.conf
rm /tmp/hermes-services.conf

# Append blocked IPs from a fixed file, avoiding duplicates
touch /etc/nginx/blocked_ips.conf
while read -r ip; do
  [ -z "$ip" ] && continue
  grep -qxF "$ip" /etc/nginx/blocked_ips.conf || echo "$ip" >> /etc/nginx/blocked_ips.conf
done < "$SRC/blocked_ips.add"

# Replace fail2ban filter from reviewed source
install -o root -g root -m 0644 "$SRC/nginx-badbots.conf" /etc/fail2ban/filter.d/nginx-badbots.conf

nginx -t
fail2ban-client reload
systemctl reload nginx
