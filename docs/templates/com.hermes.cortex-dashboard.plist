<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hermes Cortex — Dashboard Launchd Plist Template

  Two common configurations:

  1. DEDICATED VENV (recommended for production/isolated setups):
     Keeps dashboard deps separate from gateway deps.
     Create venv: python3 -m venv ~/.hermes-cortex/dashboard/venv
     Install:     ~/.hermes-cortex/dashboard/venv/bin/pip install flask

  2. THE FLEET VENV (~/.hermes-cortex/venv) — for a host that already has it;
     `fix-cortex-venv.py` fills it from the declared requirements.

  PORTABLE (2026-10-13). This template used to say "Replace CORTEX_HOME with
  $HOME (literally, launchd expands it)" and then put $HOME straight into
  ProgramArguments. launchd does NOT expand $HOME inside plist strings, so the
  job tried to exec a literal '$HOME/...' and never started — the same class of
  failure as a missing fleet venv, and a WRONG instruction on top of it. Paths
  are now expanded by a shell (/bin/bash -lc), and the log redirect lives inside
  that command because StandardOutPath must be a literal path.

  Option 2 used to point at the HERMES venv, the tree this fleet is moving off.

  Copy to: ~/Library/LaunchAgents/com.hermes.cortex-dashboard.plist
  Load:    launchctl load ~/Library/LaunchAgents/com.hermes.cortex-dashboard.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.cortex-dashboard</string>

    <!-- OPTION A: dedicated venv (shown). OPTION B: fleet venv — swap the
         interpreter for "$HOME/.hermes-cortex/venv/bin/python3" below. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/.hermes-cortex/logs"; cd "$HOME/.hermes-cortex/dashboard" || exit 78; exec "$HOME/.hermes-cortex/dashboard/venv/bin/python3" "$HOME/.hermes-cortex/dashboard/server.py" >>"$HOME/.hermes-cortex/logs/cortex-dashboard.log" 2>&amp;1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
