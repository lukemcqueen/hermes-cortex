<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hermes Cortex — cortex-gateway Launchd Plist (macOS counterpart of
  docs/templates/cortex-gateway.service, which is Linux/systemd only).

  The decoupled messaging gateway daemon. Independent of com.hermes.gateway:
  no dependency on the Hermes runtime (see docs/design/cortex-gateway.md).

  launchd has no systemd-style EnvironmentFile, so the wrapper sources the ONE
  canonical cortex env (~/hermes-cortex/.env) before exec'ing the daemon. That
  is the same file the systemd unit reads — no macOS-specific env name.

  PORTABLE + SELF-DIAGNOSING (2026-10-13). It hardcoded /Users/luke for
  WorkingDirectory and both log paths (so another Mac's job pointed at a path
  that does not exist), and it exec'd the SYSTEM python. Now:
    * every path is $HOME-expanded by /bin/bash -lc (launchd expands nothing);
    * the interpreter is the FLEET venv, the one cortex-update.sh registers
      every MCP server against;
    * the shared launcher guard runs first, so a missing venv or payload lands
      in the log as "NO INTERPRETER at <path> … how to fix it" (rc 78) instead
      of an unexplained exec failure.

  Setup:
    1. cp this file to ~/Library/LaunchAgents/com.hermes.cortex-gateway.plist
    2. launchctl load ~/Library/LaunchAgents/com.hermes.cortex-gateway.plist

  Check:  launchctl list com.hermes.cortex-gateway
          tail -f ~/Library/Logs/com.hermes.cortex-gateway.log
  Remove: launchctl unload ~/Library/LaunchAgents/com.hermes.cortex-gateway.plist

  ⚠️ Only ONE poller per bot token — stop com.hermes.gateway first, or the two
  will 409 against each other.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.cortex-gateway</string>

    <!-- Source the canonical env, check the pieces, then exec the daemon (no
         shell left running). The guard exits 78 with a named path if the venv
         or the daemon is missing, so the failure is readable in the log. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/Library/Logs"; exec >>"$HOME/Library/Logs/com.hermes.cortex-gateway.log" 2>&amp;1; set -a; . "$HOME/hermes-cortex/.env"; set +a; . "$HOME/.hermes-cortex/scripts/lib/require-fleet-venv.sh"; require_fleet_venv "$HOME/.hermes-cortex/scripts/cortex_gateway/daemon.py"; exec "$HOME/.hermes-cortex/venv/bin/python3" "$HOME/.hermes-cortex/scripts/cortex_gateway/daemon.py" --config "$HOME/.hermes-cortex/gateway.yaml"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Relaunch after a DELIBERATE exit too. launchd.plist(5): with
         SuccessfulExit=false the job is restarted in the INVERSE condition of
         success — i.e. after a NON-zero exit. The daemon therefore exits 75
         (EX_TEMPFAIL) for /restart on macOS; a clean exit(0) is PARKED by this
         policy (it is the code systemd's Restart=always relaunches instead).
         NOTE: CrashedOrAbnormalExit is NOT a launchd condition (it appears in no
         man page); a KeepAlive dict of keys launchd does not define leaves it with
         no reason to restart the job at all — neither after /restart nor a crash. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>15</integer>
</dict>
</plist>
