<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hermes Cortex — Health Push Launchd Plist

  Pushes a health vector to the Moses agent inbox every 10 minutes.
  Each agent (Titus, Gisu, Joseph) installs this on their machine.

  Setup:
    1. cp this file to ~/Library/LaunchAgents/com.hermes.health-push.plist
    2. Edit the username in the path below (replace 'titus' with your user)
    3. launchctl load ~/Library/LaunchAgents/com.hermes.health-push.plist

  Check:
    tail -f /tmp/com.hermes.health-push.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.health-push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/luke/hermes-cortex/src/scripts/health-vector-push.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AGENT_NAME</key>
        <string>titus</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/com.hermes.health-push.err</string>

    <key>StandardOutPath</key>
    <string>/dev/null</string>
</dict>
</plist>