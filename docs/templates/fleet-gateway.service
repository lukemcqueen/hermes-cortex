# fleet-gateway.service — Steadfaste Fleet standalone messaging gateway
#
# ⚠️ USER-LEVEL ONLY — must live in ~/.config/systemd/user/
#    Linux/systemd ONLY. macOS has no systemd: use the launchd counterpart
#    docs/templates/com.hermes.fleet-gateway.plist (~/Library/LaunchAgents/),
#    which sources the same canonical env before exec'ing the daemon.
#    Never copy to /etc/systemd/system/ (a second poller on the same bot
#    token gets a Telegram 409 Conflict).
#    Enable/start: systemctl --user enable --now fleet-gateway.service
#    Template source: docs/templates/fleet-gateway.service (steadfaste-fleet repo)
#
# This is the DECOUPLED replacement for the in-process `hermes gateway run`
# loop. It shares NO process, unit dependency, or env file with
# hermes-gateway.service — that independence is the point (see
# docs/design/fleet-gateway.md). Do NOT add After=/Wants=/Requires=
# hermes-gateway.service here.
#
# Config:  %h/.steadfaste-fleet/gateway.yaml   (see ops/scripts/gateway.yaml.example)
# Env:     the ONE canonical cortex env — ~/steadfaste-fleet/.env (the repo env;
#          %h/.steadfaste-fleet/.env and %h/steadfaste-fleet/.env are
#          symlinks to it). We are MIGRATING AWAY from Hermes, so this unit must
#          NOT read %h/.hermes/.env. It must define:
#            TELEGRAM_BOT_TOKEN     referenced by gateway.yaml bots[].token_ref
#            TELEGRAM_ALLOWED_USERS sender allowlist — REQUIRED; without it any
#                                   Telegram user could talk to the agent
#            TELEGRAM_HOME_CHANNEL  default delivery target — REQUIRED
#            GATEWAY_SECRET         HMAC signing secret for bus envelopes — REQUIRED
#            CORTEX_BUS_URL         (or set bus_url in gateway.yaml)
#            CORTEX_BUS_TOKEN  or  CORTEX_BASIC_AUTH
#            TELEGRAM_API_BASE      (optional)
#          Same NAMES as Hermes (no invented config), but the VALUES live here,
#          in the cortex env — copy them over once during migration.
#          Migrating a value without printing it:
#            grep -E '^TELEGRAM_(BOT_TOKEN|ALLOWED_USERS|HOME_CHANNEL)=' \
#              "$HOME/.hermes/.env" >> "$HOME/steadfaste-fleet/.env"
#
# ⚠️ Only ONE poller per bot token. Before enabling this, stop the incumbent
#    (systemctl --user stop hermes-gateway.service) or the two will 409.

[Unit]
Description=Steadfaste Fleet Gateway (fleet-gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.steadfaste-fleet/scripts
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/steadfaste-fleet/.env
# Fail CLOSED on the live token. The warning above is a comment, and a comment
# cannot fail — this refuses to start when the config's token_ref resolves to
# TELEGRAM_BOT_TOKEN (the bot hermes-gateway.service polls) or names it directly.
# See ops/scripts/fleet_gateway/guard_distinct_token.py.
#
# The FLEET venv, not the system python (2026-10-13): it is the interpreter
# fleet-update.sh registers every MCP server against, and the one the macOS
# counterpart (docs/templates/com.hermes.fleet-gateway.plist) execs. The shared
# launcher guard runs first, so a missing venv or daemon is logged as
# "NO INTERPRETER at <path> … how to fix it" (rc 78) instead of an unexplained
# exec failure — the same diagnosis the plist gives on macOS.
ExecStartPre=/bin/bash -lc '. %h/.steadfaste-fleet/scripts/lib/require-fleet-venv.sh; require_fleet_venv %h/.steadfaste-fleet/scripts/fleet_gateway/daemon.py; exec "%h/.steadfaste-fleet/venv/bin/python3" "%h/.steadfaste-fleet/scripts/fleet_gateway/guard_distinct_token.py" "%h/.steadfaste-fleet/gateway.yaml"'
ExecStart=/bin/bash -lc '. %h/.steadfaste-fleet/scripts/lib/require-fleet-venv.sh; require_fleet_venv %h/.steadfaste-fleet/scripts/fleet_gateway/daemon.py; exec "%h/.steadfaste-fleet/venv/bin/python3" "%h/.steadfaste-fleet/scripts/fleet_gateway/daemon.py" --config "%h/.steadfaste-fleet/gateway.yaml"'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
