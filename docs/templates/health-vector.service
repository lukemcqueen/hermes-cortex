# health-vector.service — Steadfaste Fleet Agent Health Vector Server (internal :8905)
#
# ⚠️ USER-LEVEL ONLY — must live in ~/.config/systemd/user/
#    Never copy to /etc/systemd/system/ (causes port conflicts).
#    Enable/start: systemctl --user enable health-vector.service
#    Template source: docs/templates/health-vector.service (steadfaste-fleet repo)
#
# INTERNAL PORT: 8905 — nginx upstream health_backend expects this.
# nginx proxies external :xx007 → internal :8905 for agent health polling.
# Do NOT change this port — the nginx templates across all agent configs
# reference 127.0.0.1:8905 for the health_backend upstream.
#
# Override port only if the nginx config explicitly defines a different upstream.
# Then patch BOTH the service ExecStart AND the nginx upstream server directive.

[Unit]
Description=Steadfaste Fleet Health Vector Server
After=network.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
# The FLEET venv, not the system python (2026-10-13) — the interpreter
# fleet-update.sh registers every MCP server against and the one the macOS
# counterpart (docs/templates/com.hermes.health-push.plist) uses. The shared
# launcher guard names a missing venv/payload in the journal instead of leaving
# an unexplained exec failure.
ExecStart=/bin/bash -lc '. %h/.steadfaste-fleet/scripts/lib/require-fleet-venv.sh; require_fleet_venv %h/steadfaste-fleet/ops/scripts/health/health-vector.py; exec "%h/.steadfaste-fleet/venv/bin/python3" "%h/steadfaste-fleet/ops/scripts/health/health-vector.py" --serve 8905'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target