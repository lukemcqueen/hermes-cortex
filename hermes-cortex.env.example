# ── Hermes Cortex — Environment Configuration Example ──
# Copy this to hermes-cortex.env (gitignored) and fill in your values.
#
# 🔒 Protect: chmod 600 hermes-cortex.env
#
# Source order (last wins):
#   1. Script defaults
#   2. ~/.hermes/models.env
#   3. hermes-cortex.env (this file — gitignored)
#   4. Runtime env vars (export VAR=value before running)

# ── Inbox Connection ──
# The inbox API endpoint for agent-to-agent messaging.
# All agents connect to the same inbox server at :13004.
# CORTEX_INBOX_URL="https://bus.example.org:13004"
#
# Basic Auth credentials: "agent-name:password"
# Each agent has a unique password. Get yours from the fleet admin.
# CORTEX_INBOX_AUTH="moses:your-unique-password-here"
#
# Your agent name — must match the 'CORTEX_INBOX_AUTH' username part.
# AGENT_NAME="moses"

# ── Langfuse (LLM Observability) ──
# Optional. Used for LLM trace evaluation and scoring.
# Get keys from your Langfuse instance (local or cloud).
# HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
# HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
# HERMES_LANGFUSE_BASE_URL=http://localhost:3000
# HERMES_LANGFUSE_ENV=local
# HERMES_LANGFUSE_RELEASE=v1
# HERMES_LANGFUSE_SAMPLE_RATE=1.0

# ── Health Reporting ──
# Optional. Used by health-vector-push.sh to push system health to the inbox.
# Same CORTEX_INBOX_URL and CORTEX_INBOX_AUTH are shared from above.
