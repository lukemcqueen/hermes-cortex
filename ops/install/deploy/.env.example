# ─────────────────────────────────────────────────────────────
# Langfuse v3 — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to ~/langfuse/.env and fill in your values.
# See deploy/README-langfuse-clickhouse.md for full setup guide.
#
# Quick-seed all secrets (run this once, then edit as needed):
#   LANGFUSE_SALT=$(openssl rand -hex 32)
#   LANGFUSE_SECRET_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -hex 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_POSTGRES_PASSWORD=$(openssl rand -hex 20)
#   LANGFUSE_CLICKHOUSE_PASSWORD=$(openssl rand -hex 16)
#   LANGFUSE_REDIS_AUTH=$(openssl rand -hex 32)
#   LANGFUSE_MINIO_ACCESS_KEY=$(openssl rand -hex 16)
#   LANGFUSE_MINIO_SECRET_KEY=$(openssl rand -hex 32)
#   LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-$(openssl rand -hex 16)
#   LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────

# ── Required: Database & Cache ──
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_POSTGRES_PASSWORD=

# ── Required: MinIO (local S3) ──
LANGFUSE_MINIO_ACCESS_KEY=
LANGFUSE_MINIO_SECRET_KEY=

# ── Required: Auth & Encryption ──
LANGFUSE_SALT=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=

# ── Optional: First-run project seeding ──
# Generated automatically by docker-entrypoint if left unset.
# Set these if you want deterministic keys across restarts:
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_PROJECT_NAME=Hermes Agent

# ── Optional: Logging & Behavior ──
# LANGFUSE_LOG_LEVEL=info
# LANGFUSE_API_TRACES_REJECT_NO_DATE_RANGE=true
# LANGFUSE_API_TRACES_DEFAULT_DATE_RANGE_DAYS=7

# ── Optional: OpenTelemetry ──
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=langfuse


# ─────────────────────────────────────────────────────────────
# Hermes Agent — Langfuse Integration
# ─────────────────────────────────────────────────────────────
# These go in ~/.hermes/.env, not ~/langfuse/.env.
# They connect Hermes to the running Langfuse instance.
#
# After provisioning the first admin project (step 4 in README),
# set the project keys here:
# ─────────────────────────────────────────────────────────────

# HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
# HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
# HERMES_LANGFUSE_BASE_URL=http://localhost:3000
# HERMES_LANGFUSE_ENV=local
# HERMES_LANGFUSE_SAMPLE_RATE=1.0
