{
  "version": 4,
  "description": "Agent registry for Hermes Cortex v4. Every agent must have entries for all 5 fleet concerns: identity & trust, topology, choreography, economics, and sovereign control. health_method: 'http' for server agents with reachable health endpoints, 'inbox' for client-only agents that push via inbox.",
  "health_vector_map": [
    "resources", "services", "no_errored_crons", "no_stale_crons",
    "nginx", "ollama", "gbrain", "disk_ok", "gbrain_sources_ok"
  ],
  "routing": {
    "broadcast_topics": [
      "luke",
      "all",
      "general"
    ],
    "agent_prefix_topics": true
  },
  "agents": {
    "moses": {
      "name": "Moses",
      "role": "orchestrator",
      "host": "your-domain.com",
      "hostname": "orchestrator-1",
      "is_server": true,
      "is_orchestrator": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://your-domain.com:13007/health",
      "description": "Moses — primary orchestrator server, ports 13001-13007. Fleet command, bus server, Postgres, skill lifecycle, fleet watchdogs.",
      "inbox_user": "moses",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": true,
        "has_cron_tool": true,
        "has_terminal": true,
        "bus_access": "host",
        "maintenance_window": "any",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "assistant",
            "permissions": "edit",
            "tool_scope": [
              "hermes-cortex",
              "agent-bus",
              "nginx",
              "docker",
              "postgres"
            ],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": null
        },
        "choreography": {
          "bus_access": "host",
          "inbox": "inbox_moses",
          "handoff_schemas": []
        },
        "economics": {
          "budget": {
            "daily_token_cap": 100000,
            "concurrent_runs": 3,
            "cost_center": "fleet-core"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F2",
          "kill_switch": false,
          "allow_destructive_ops": true,
          "deny_paths": []
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "debug",
        "tracing": "all",
        "judge_scorer": true
      },
      "service_layer": {
        "type": "systemd",
        "health_endpoint": true,
        "auto_remediate": true
      }
    },
    "gisu": {
      "name": "Gisu",
      "role": "server-agent",
      "hostname": "worker-1",
      "is_server": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://your-gisu-host:13007/health",
      "description": "Gisu — operations server (set health_url locally, port 13007). Local maintenance and health reporting.",
      "inbox_user": "gisu",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": false,
        "has_cron_tool": false,
        "has_terminal": true,
        "bus_access": "client",
        "maintenance_window": "any",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "claw",
            "permissions": "run",
            "tool_scope": [
              "hermes-cortex",
              "local-services"
            ],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": "moses"
        },
        "choreography": {
          "bus_access": "client",
          "inbox": "inbox_gisu",
          "handoff_schemas": []
        },
        "economics": {
          "budget": {
            "daily_token_cap": 50000,
            "concurrent_runs": 1,
            "cost_center": "fleet-server"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F1",
          "kill_switch": false,
          "allow_destructive_ops": false,
          "deny_paths": [
            "*/nginx/**",
            "*/docker/**",
            "*.env"
          ]
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "info",
        "tracing": "errors-only",
        "judge_scorer": false
      },
      "service_layer": {
        "type": "systemd",
        "health_endpoint": true,
        "auto_remediate": true
      }
    },
    "joseph": {
      "name": "Joseph",
      "role": "server-agent",
      "hostname": "worker-2",
      "is_server": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://your-domain.com:12007/health",
      "description": "Joseph — web/infra server (set health_url locally, port 12007, no auth). Hosts production web services.",
      "inbox_user": "joseph",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": true,
        "has_cron_tool": false,
        "has_terminal": true,
        "bus_access": "client",
        "maintenance_window": "off-peak",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "claw",
            "permissions": "run",
            "tool_scope": [
              "hermes-cortex",
              "nginx",
              "web-services"
            ],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": "moses"
        },
        "choreography": {
          "bus_access": "client",
          "inbox": "inbox_joseph",
          "handoff_schemas": [
            {
              "from": "moses",
              "schema": "schema-v1",
              "validator": "validate-handoff.sh"
            }
          ]
        },
        "economics": {
          "budget": {
            "daily_token_cap": 50000,
            "concurrent_runs": 1,
            "cost_center": "fleet-server"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F1",
          "kill_switch": false,
          "allow_destructive_ops": false,
          "deny_paths": [
            "*/nginx/sites-enabled/**",
            "*/docker/**",
            "*.env",
            "*/secrets/**"
          ]
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "info",
        "tracing": "all",
        "judge_scorer": false
      },
      "service_layer": {
        "type": "systemd",
        "health_endpoint": true,
        "auto_remediate": true
      }
    },
    "kustos": {
      "name": "Kustos",
      "role": "server-agent",
      "hostname": "worker-3",
      "is_server": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://your-kustos-host:13007/health",
      "description": "Kustos — security server (set health_url locally, port 13007). Firewall, fail2ban, IP blocking pipelines.",
      "inbox_user": "kustos",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": true,
        "has_cron_tool": false,
        "has_terminal": true,
        "bus_access": "client",
        "maintenance_window": "any",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "claw",
            "permissions": "edit",
            "tool_scope": [
              "hermes-cortex",
              "nginx",
              "fail2ban",
              "ip-blocking"
            ],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": "moses"
        },
        "choreography": {
          "bus_access": "client",
          "inbox": "inbox_kustos",
          "handoff_schemas": []
        },
        "economics": {
          "budget": {
            "daily_token_cap": 50000,
            "concurrent_runs": 1,
            "cost_center": "fleet-security"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F1",
          "kill_switch": true,
          "allow_destructive_ops": false,
          "deny_paths": [
            "*/iptables/**",
            "*/ufw/**",
            "*.env",
            "*/secrets/**"
          ]
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "info",
        "tracing": "all",
        "judge_scorer": false
      },
      "service_layer": {
        "type": "systemd",
        "health_endpoint": true,
        "auto_remediate": true
      }
    },
    "titus": {
      "name": "Titus",
      "role": "dev-agent",
      "hostname": "worker-4",
      "is_server": false,
      "accessible": true,
      "health_method": "inbox",
      "platform": "macOS",
      "description": "Titus — macOS developer machine. NOT a server — do not poll. Pushes health vector to inbox using health-vector-push.sh. Multiple project repos.",
      "inbox_user": "titus",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": false,
        "has_cron_tool": false,
        "has_terminal": true,
        "bus_access": "client",
        "maintenance_window": "any",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "assistant",
            "permissions": "edit",
            "tool_scope": [
              "hermes-cortex"
            ],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": "moses"
        },
        "choreography": {
          "bus_access": "client",
          "inbox": "inbox_titus",
          "handoff_schemas": []
        },
        "economics": {
          "budget": {
            "daily_token_cap": 75000,
            "concurrent_runs": 2,
            "cost_center": "fleet-dev"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F1",
          "kill_switch": false,
          "allow_destructive_ops": false,
          "deny_paths": [
            "*.env"
          ]
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "debug",
        "tracing": "all",
        "judge_scorer": false
      },
      "service_layer": {
        "type": "launchd",
        "health_endpoint": false,
        "auto_remediate": false
      }
    },
    "esther": {
      "name": "Esther",
      "role": "orchestrator",
      "hostname": "worker-5",
      "is_server": true,
      "is_backup_orchestrator": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://your-domain.com:14007/health",
      "description": "Esther — backup orchestrator, sustainability & materials expert. Hot standby — same capabilities as Moses, takes over if primary is down.",
      "inbox_user": "esther",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": true,
        "has_cron_tool": true,
        "has_terminal": true,
        "bus_access": "host",
        "maintenance_window": "any",
        "git": {
