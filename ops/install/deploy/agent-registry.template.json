{
  "version": 4,
  "description": "Agent registry for Hermes Cortex v4. Template — copy to ~/.hermes-cortex/state/agent-registry.json and fill in real URLs and settings during setup. Every agent MUST have entries for all 5 fleet concerns: identity & trust, topology, choreography, economics, and sovereign control.",
  "health_vector_map": [
    "resources", "services", "no_errored_crons", "no_stale_crons",
    "nginx", "ollama", "mycortex", "disk_ok", "mycortex_sources_ok"
  ],
  "routing": {
    "broadcast_topics": [
      "luke",
      "all",
      "general"
    ],
    "agent_prefix_topics": true
  },
  "agents": {
    "moses": {
      "name": "Moses",
      "role": "orchestrator",
      "hostname": "moses",
      "is_server": true,
      "is_orchestrator": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "health_url": "https://{{CORTEX_DOMAIN}}:{{CORTEX_HEALTH_PORT}}/health",
      "description": "Moses — primary orchestrator server. Fleet command, bus server, Postgres, skill lifecycle.",
      "inbox_user": "moses",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local",
      "capabilities": {
        "has_git": true,
        "has_sudo": true,
        "has_cron_tool": true,
        "has_terminal": true,
        "bus_access": "host",
        "maintenance_window": "any",
        "git": {
          "remote": "origin",
          "default_branch": "main",
          "repo_path": "~/hermes-cortex"
        },
        "deploy": {
          "update_method": "cortex-update",
          "doctor_path": "~/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
        }
      },
      "fleet_concerns": {
        "identity": {
          "principal": {
            "type": "assistant",
            "permissions": "edit",
            "tool_scope": ["{{SCOPE_LIST}}"],
            "version": "1.0.0"
          }
        },
        "topology": {
          "type": "hierarchical",
          "parent": null
        },
        "choreography": {
          "bus_access": "host",
          "inbox": "inbox_moses",
          "handoff_schemas": []
        },
        "economics": {
          "budget": {
            "daily_token_cap": "{{TOKEN_CAP}}",
            "concurrent_runs": "{{CONCURRENT_RUNS}}",
            "cost_center": "{{COST_CENTER}}"
          }
        },
        "sovereign_control": {
          "autonomy_tier": "F2",
          "kill_switch": false,
          "allow_destructive_ops": true,
          "deny_paths": []
        }
      },
      "observability": {
        "langfuse": true,
        "log_level": "debug",
        "tracing": "all",
        "judge_scorer": true
      },
      "service_layer": {
        "type": "systemd",
        "health_endpoint": true,
        "auto_remediate": true
      }
    },
    "esther": {
      "name": "Esther",
