<?xml version="1.0"?>
<!--
  Low-memory ClickHouse configuration for single-server / non-production environments.
  Reduces background thread pools, disables verbose system logging, and caps memory.
  See: https://clickhouse.com/docs/operations/server-configuration-parameters/settings

  ⚠️ ClickHouse 25.5-alpine bug: reducing >2 background pool settings simultaneously
  triggers SIGSEGV (exit code 139) or exit code 36 during initialization. Only the two
  most impactful settings are reduced here. The rest use their defaults. Tested settings:
  - background_pool_size >= 13 (floor in CH 25.5 — values <= 12 crash)
  - background_schedule_pool_size >= 16 (default 512, reducing to 16 saves 496 threads)
  - max_thread_pool_size / thread_pool_queue_size: keep at defaults (10000) — reducing
    triggers crash when combined with reduced background pools
  - All other background pool settings: keep at defaults (same crash-combination bug)

  ⚠️ Cache caps (uncompressed_cache_size, mark_cache_size, cache_size_to_ram_max_ratio):
  ClickHouse defaults assume 64+ GiB of RAM (8 GiB uncompressed cache, 5 GiB mark
  cache). In a 2 GiB container, these defaults cause ALL merges to fail because caches
  consume the available memory before background merges can run. Symptom:
  TotalMergeFailures climbs indefinitely, all merges fail with MEMORY_LIMIT_EXCEEDED,
  and system log tables accumulate stale parts that can't be cleaned up. Fix:
  Set uncompressed_cache_size=256 MiB, mark_cache_size=128 MiB, and
  cache_size_to_ram_max_ratio=0.4.

  ⚠️ Merge size defaults: ClickHouse's default max_bytes_to_merge_at_max_space_in_pool
  is 150 GB, which will always OOM in a 2 GiB container. Must be reduced drastically
  so each merge operation fits within available memory.

  Diagnosis:
  - Check merge failures:  SELECT event, value FROM system.events WHERE event LIKE '%Merge%';
  - Check memory limit:    SELECT name, value FROM system.server_settings WHERE name LIKE '%memory%';
  - Check merge size:      SELECT name, value FROM system.merge_tree_settings WHERE name LIKE '%max_byte%';
  - Check server log:      grep 'MEMORY_LIMIT\|MergeTreeBackgroundExecutor' /var/log/clickhouse-server/clickhouse-server.err.log
-->
<clickhouse>

    <!-- ── Thread pools (defaults assume multi-core + high throughput) ── -->
    <background_pool_size>13</background_pool_size>
    <!-- merges & mutations; default 16; floor 13 in CH 25.5 (≤12 crashes) -->
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <!-- periodic ops (replication, DNS, etc.); default 512 — biggest savings -->

    <!-- NOTE: background_merges_mutations_concurrency_ratio intentionally
         NOT set here. CH 25.5-alpine crashes on >2 reduced background pool
         settings (exit code 36 during init). background_pool_size=13 +
         background_schedule_pool_size=16 are already reduced. Adding
         a third triggers the bug. The default ratio of 2 gives 26
         concurrent tasks, which is acceptable with small merge sizes. -->

    <!-- ── Query concurrency ── -->
    <max_concurrent_queries>25</max_concurrent_queries>
    <!-- default 1000; reduced from 50 for more headroom -->

    <!-- ── Merge memory limits ── -->
    <!-- Hard soft limit: stop scheduling new merges when merges use >512 MB.
         Default: 0 (unlimited) — combined with 0.3 ratio gives ~614 MB for 2GiB container.
         Explicit limit prevents all merges from running simultaneously. -->
    <merges_mutations_memory_usage_soft_limit>536870912</merges_mutations_memory_usage_soft_limit>
    <!-- 512 MB -->
    <!-- Fallback ratio if soft_limit is 0: uses memory_amount * ratio. -->
    <merges_mutations_memory_usage_to_ram_ratio>0.25</merges_mutations_memory_usage_to_ram_ratio>

    <!-- ── Merge tuning ── -->
    <merge_tree>
        <!-- Each merge fits in ~1/4 of available memory (default 150 GB will always OOM).
             max_bytes_to_merge_at_max_space_in_pool: ~500 MB (default 150 GB!)
             max_bytes_to_merge_at_min_space_in_pool: ~50 MB  (default 1 MB) -->
        <max_bytes_to_merge_at_max_space_in_pool>536870912</max_bytes_to_merge_at_max_space_in_pool>
        <!-- 512 MB (memory limit increased from 3g to 6g, plenty of room for merge) -->
        <max_bytes_to_merge_at_min_space_in_pool>52428800</max_bytes_to_merge_at_min_space_in_pool>
        <!-- 50 MB -->

        <!-- Smaller blocks = less memory per merge block.
             Default: 8192. Currently: 2048. Reducing further to 512. -->
        <merge_max_block_size>512</merge_max_block_size>

        <!-- Immediately lower merge sizes when pool is full (no free slots).
             Default: 8. Setting to 0 avoids the "stuck at big merges" death spiral. -->
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>0</number_of_free_entries_in_pool_to_lower_max_size_of_merge>

        <!-- Faster retry after failed merges (default 5000ms) -->
        <merge_selecting_sleep_ms>1000</merge_selecting_sleep_ms>
    </merge_tree>

    <!-- ── Cache caps — defaults assume 64+ GiB, but we're at 2 GiB ── -->
    <uncompressed_cache_size>268435456</uncompressed_cache_size>         <!-- 256 MB (default 8 GB) -->
    <mark_cache_size>134217728</mark_cache_size>                         <!-- 128 MB (default 5 GB) -->
    <cache_size_to_ram_max_ratio>0.4</cache_size_to_ram_max_ratio>       <!-- max 40% RAM for all caches -->

    <!-- ── Disable verbose system log tables ── -->
    <text_log>
        <database>system</database>
        <table>text_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <level>error</level>
    </text_log>
    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <collect_interval_milliseconds>60000</collect_interval_milliseconds>
    </metric_log>
    <asynchronous_metric_log>
        <database>system</database>
        <table>asynchronous_metric_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <collect_interval_milliseconds>60000</collect_interval_milliseconds>
    </asynchronous_metric_log>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
    </query_log>
    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <level>error</level>
    </query_thread_log>
    <query_views_log>
        <database>system</database>
        <table>query_views_log</table>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <level>error</level>
    </query_views_log>
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <flush_interval_milliseconds>30000</flush_interval_milliseconds>
        <level>error</level>
    </trace_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
    </part_log>

    <!-- ── System log TTL: auto-expire old data to prevent merge memory pressure ── -->
    <database_system>
        <trace_log_ttl>7</trace_log_ttl>           <!-- 7 days -->
        <metric_log_ttl>7</metric_log_ttl>          <!-- 7 days -->
        <asynchronous_metric_log_ttl>7</asynchronous_metric_log_ttl>  <!-- 7 days -->
        <query_log_ttl>7</query_log_ttl>            <!-- 7 days -->
        <text_log_ttl>14</text_log_ttl>             <!-- 14 days -->
    </database_system>

</clickhouse>
