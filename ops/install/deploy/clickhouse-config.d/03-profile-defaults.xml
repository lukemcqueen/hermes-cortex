<?xml version="1.0"?>
<!--
  Profile-level default settings for the 'default' user profile.
  These live in config.d/ alongside the server-level overrides because
  ClickHouse merges <profiles> from any XML file under config.d/ or users.d/.
-->
<clickhouse>
    <profiles>
        <default>
            <!-- Per-query memory limit: 1.5GB (2026-08-09 fix) — was 3GB, which
                 EXCEEDED max_server_memory_usage (2.7GB in 3GiB container) and
                 killed every merge (Code 241, TotalMergeFailures 4372+).
                 Rule: must be <=50% of (container_mem_limit * 0.9) for
                 concurrent merges: 3 * 0.9 * 0.5 = 1.35GB, rounded to 1.5GB. -->
            <max_memory_usage>1500000000</max_memory_usage>
            <!-- Spill to disk when GROUP BY exceeds 1GB -->
            <max_bytes_before_external_group_by>1000000000</max_bytes_before_external_group_by>
            <!-- Max threads per query (1 CPU core allocated) -->
            <max_threads>2</max_threads>
            <!-- Smaller blocks = less memory per query -->
            <max_block_size>4096</max_block_size>
            <!-- ── Disable sampling profiler (prevents system.trace_log bloat) ── -->
            <!-- Kustos cisnet02: 48G trace_log from 10ms default profiler.
                 Setting to 0 disables the stack-trace writer entirely.
                 Must be in users.d profile AND container restarted. -->
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
        </default>
    </profiles>
</clickhouse>