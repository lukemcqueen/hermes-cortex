<?xml version="1.0"?>
<!--
  Profile-level default settings for the 'default' user profile.
  These live in config.d/ alongside the server-level overrides because
  ClickHouse merges <profiles> from any XML file under config.d/ or users.d/.
-->
<clickhouse>
    <profiles>
        <default>
            <!-- Per-query memory limit: 2GB (matches 2GB container) -->
            <max_memory_usage>2000000000</max_memory_usage>
            <!-- Spill to disk when GROUP BY exceeds 1GB -->
            <max_bytes_before_external_group_by>1000000000</max_bytes_before_external_group_by>
            <!-- Max threads per query (1 CPU core allocated) -->
            <max_threads>2</max_threads>
            <!-- Smaller blocks = less memory per query -->
            <max_block_size>4096</max_block_size>
        </default>
    </profiles>
</clickhouse>