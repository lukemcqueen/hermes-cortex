[Unit]
Description=Cortex Bus Server (PGMQ) — canonical bus for both orchestrators
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/hermes-cortex/core
Environment=PYTHONPATH=%h/hermes-cortex/core
ExecStart=%h/.hermes/hermes-agent/venv/bin/python3 -m uvicorn cortex_bus.server:app --host 127.0.0.1 --port 8903 --log-level warning
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
