[Unit]
Description=GBrain Autopilot
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/.gbrain
ExecStart=%h/.gbrain/autopilot-run.sh
Restart=always
RestartSec=30
Environment=GBRAIN_AI_EMBED_TIMEOUT_MS=300000
StandardOutput=append:%h/.gbrain/autopilot.log
StandardError=append:%h/.gbrain/autopilot.err
# Runtime hardening
NoNewPrivileges=yes

[Install]
WantedBy=default.target
