# ───────────────────────────────────────────────────────────────
#  hermes-cortex.env — unified configuration for all Hermes Cortex
#  apps, functions, and deployment scripts.
# ───────────────────────────────────────────────────────────────
#
#  ⚠  THIS IS A TEMPLATE — copy to ~/.hermes/hermes-cortex.env
#     and edit to match your agent's environment.
#
#     cp deploy/hermes-cortex.env.example ~/.hermes/hermes-cortex.env
#
#  ⚠ PYTHON 3.10+ REQUIRED — macOS ships Python 3.9 which breaks
#     PEP 604 (`str | None` syntax). All Hermes scripts use
#     `#!/usr/bin/env python3` (portable). Install via: brew install python@3.12
#     or `uv python install 3.12` — the env picks up whatever `python3` resolves to.
#
#  All scripts auto-source ~/.hermes/hermes-cortex.env at startup.
#  This file is outside the git repo and survives cortex-update.sh.
#
#  Resolution priority (highest to lowest):
#    1. Runtime environment variable (export FOO=bar before script)
#    2. ~/.hermes/hermes-cortex.env (this file)
#    3. ~/.hermes/models.env (legacy — still loaded as fallback)
#    4. deploy/hermes-services.env (legacy — still loaded as fallback)
#    5. Shipping defaults hardcoded in each script
#
# ───────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════
# SECTION 1: Ollama Model Configuration
# ═══════════════════════════════════════════════════════════════
# Controls which LLM/embedding models are used by each component.
# See ~/.hermes/models.env for legacy location (still picked up).

# LLM-as-judge for scoring, classification, quality gates
# Default: qwen2.5:3b
#JUDGE_MODEL=qwen2.5:3b

# Text embeddings for gbrain, session cache, loop scorer, offline_code
# Default: nomic-embed-text:v1.5
#EMBEDDING_MODEL=nomic-embed-text:v1.5

# Code generation via offline_code
# Default: auto-detected by RAM (3b on <32GB, 7b on ≥32GB)
#CODING_MODEL=qwen2.5:3b

# Reserved for creative/text generation tasks
# Default: qwen2.5:3b
#CREATIVE_MODEL=qwen2.5:3b

# Default chat model (used by Hermes Agent when no provider is specified)
# Example: deepseek-v4-flash, anthropic/claude-sonnet-4
#DEFAULT_MODEL=deepseek-v4-flash


# ═══════════════════════════════════════════════════════════════
# SECTION 2: Nginx Deploy Configuration
# ═══════════════════════════════════════════════════════════════
# Controls nginx reverse-proxy deployment for Cortex services.
# These override auto-detected OS defaults (set by os-config.sh).

# Two-digit port prefix for nginx server blocks.
# Template ships as 13xxx; change to your agent's prefix:
#   12 = Joseph, 13 = Titus (default), 14 = Esther, etc.
#CORTEX_NGINX_PORT_PREFIX=13

# Path to nginx root config directory.
# Defaults per OS: /opt/homebrew/etc/nginx (macOS ARM),
#                  /usr/local/etc/nginx (macOS Intel),
#                  /etc/nginx (Linux)
#NGINX_ROOT=/etc/nginx

# Path to nginx active config directory (servers/ or sites-enabled/).
# Defaults per OS: /opt/homebrew/etc/nginx/servers (macOS ARM),
#                  /usr/local/etc/nginx/servers (macOS Intel),
#                  /etc/nginx/sites-enabled (Linux)
#NGINX_CONFIG_DIR=/etc/nginx/sites-enabled

# Path to nginx log directory.
# Defaults per OS: /opt/homebrew/var/log/nginx (macOS ARM),
#                  /usr/local/var/log/nginx (macOS Intel),
#                  /var/log/nginx (Linux)
#NGINX_LOG_DIR=/var/log/nginx

# Path to htpasswd file.
# Defaults:  /opt/homebrew/etc/nginx/.htpasswd (macOS ARM),
#            /usr/local/etc/nginx/.htpasswd (macOS Intel),
#            /etc/nginx/.hermes-htpasswd (Linux)
#NGINX_HTPASSWD=/etc/nginx/.hermes-htpasswd


# ═══════════════════════════════════════════════════════════════
# SECTION 3: SSL Certificate Configuration
# ═══════════════════════════════════════════════════════════════
# Controls TLS termination for nginx server blocks.
# Auto-detection order when unset:
#   1. These env vars (highest priority)
#   2. /etc/letsencrypt/live/<CORTEX_SSL_DOMAIN>/
#   3. /etc/letsencrypt/live/*/ (scan all)
#   4. ~/certs/fullchain.pem + privkey.pem (dev fallback)

# Full path to SSL certificate file
#CORTEX_SSL_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem

# Full path to SSL certificate private key
#CORTEX_SSL_CERT_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# Domain for Let's Encrypt auto-lookup (ignored if CERT_PATH is set)
#CORTEX_SSL_DOMAIN=example.com


# ═══════════════════════════════════════════════════════════════
# SECTION 4: Path Overrides
# ═══════════════════════════════════════════════════════════════
# Only needed if your setup deviates from defaults.

# Path to hermes-cortex repo (if not at $HOME/hermes-cortex)
#CORTEX_REPO=$HOME/hermes-cortex

# Path to Hermes home (if not at $HOME/.hermes-cortex)
#HERMES_HOME=$HOME/.hermes-cortex


# ═══════════════════════════════════════════════════════════════
# SECTION 5: Feature Flags & Safety
# ═══════════════════════════════════════════════════════════════

# Set to any value to skip nginx test and reload during deploy.
# Useful for container/headless environments.
#CORTEX_SKIP_NGINX=1

# Force nginx config redeploy even when checksums match.
#CORTEX_FORCE_DEPLOY=1
