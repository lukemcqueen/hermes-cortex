#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  hermes-nginx-clean-restart — Kill orphaned nginx master
#  and restart cleanly.
#
#  Deployed by cortex-update.sh to /usr/local/sbin/.
#
#  Usage:
#    sudo hermes-nginx-clean-restart <PID>
# ─────────────────────────────────────────────────────────────
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage: $0 <nginx-master-pid>"
  exit 1
fi

PID="$1"

# Verify the PID is actually an nginx master
if ! ps -p "$PID" -o cmd= 2>/dev/null | grep -q 'nginx: master'; then
  echo "✗ PID $PID is not an nginx master process"
  exit 1
fi

echo "── Step 1: Writing PID ${PID} to /run/nginx.pid ──"
echo "$PID" > /run/nginx.pid
echo "  ✓ /run/nginx.pid written"

echo ""
echo "── Step 2: Graceful shutdown (nginx -s quit) ──"
if nginx -s quit 2>&1; then
  echo "  ✓ nginx -s quit sent"
else
  echo "  ⚠ nginx -s quit reported an issue, checking..."
fi

# Wait for the old master to exit
echo ""
echo "── Step 3: Waiting for ports to release ──"
for i in $(seq 1 10); do
  if ! ps -p "$PID" >/dev/null 2>&1; then
    echo "  ✓ Old master exited after ${i}s"
    break
  fi
  sleep 1
done

if ps -p "$PID" >/dev/null 2>&1; then
  echo "  ⚠ Old master still alive after 10s — forcing systemctl restart"
fi

echo ""
echo "── Step 4: Starting nginx ──"
if systemctl start nginx 2>&1; then
  echo "  ✓ nginx started"
else
  echo "  ✗ nginx failed to start"
  systemctl status nginx --no-pager -l 2>&1 | head -10
  exit 1
fi

echo ""
echo "── Step 5: Verification ──"
sleep 1
if systemctl is-active --quiet nginx; then
  echo "  ✓ nginx is active"
  ps aux | grep 'nginx:' | grep -v grep
else
  echo "  ✗ nginx is not active"
  exit 1
fi

echo ""
echo "━━━ Clean restart complete ━━━"
