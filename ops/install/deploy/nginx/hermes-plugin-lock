#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  hermes-plugin-lock — Restricted lock/unlock for governance
#  enforcer plugin __init__.py (Linux + macOS)
#
#  Linux:   /usr/local/sbin/hermes-plugin-lock
#           uses chattr +i (requires root NOPASSWD in sudoers)
#  macOS:   /usr/local/bin/hermes-plugin-lock
#           uses chflags uchg (no root needed for user-immutable)
#
#  ONLY operates on:
#    ~/.hermes/plugins/governance-enforcer/__init__.py
#
#  Path is hardcoded and validated below — no argument injection.
#  This is the ONLY command in sudoers related to plugin locking.
#
#  Usage:
#    sudo hermes-plugin-lock lock     → set immutable
#    sudo hermes-plugin-lock unlock   → unset immutable
#    sudo hermes-plugin-lock status   → show flags
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# Detect platform
_os=$(uname -s)

# Resolve target path — sudo may set HOME=/root, so find the real user's home
# SUDO_USER handles sudo context. $USER handles direct runs.
# logname is NOT used — it returns 'root' in automation/container
# contexts (Hermes agent, cron, launchd), producing wrong paths.
REAL_USER="${SUDO_USER:-$USER}"
if [[ "$_os" == "Darwin" ]]; then
  REAL_HOME=$(dscl . -read "/Users/$REAL_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
else
  REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"
fi
: "${REAL_HOME:-$HOME}"
TARGET="${REAL_HOME}/.hermes/plugins/governance-enforcer/__init__.py"

if [[ ! -f "$TARGET" ]]; then
  echo "ERROR: Plugin __init__.py not found at $TARGET"
  exit 1
fi

case "${1:-help}" in
  lock)
    if [[ "$_os" == "Darwin" ]]; then
      chflags uchg "$TARGET"
    else
      chattr +i "$TARGET"
    fi
    echo "LOCKED: $TARGET"
    ;;
  unlock)
    if [[ "$_os" == "Darwin" ]]; then
      chflags nouchg "$TARGET"
    else
      chattr -i "$TARGET"
    fi
    echo "UNLOCKED: $TARGET"
    ;;
  status)
    if [[ "$_os" == "Darwin" ]]; then
      ls -lO "$TARGET" | awk '{for(i=1;i<=NF;i++){if($i~/^[a-z]+chg/||$i~/^[a-z]+immutable/){print $0;exit}} print $0}'
    else
      lsattr "$TARGET"
    fi
    ;;
  *)
    echo "Usage: $0 {lock|unlock|status}"
    echo ""
    echo "Restricted helper for governance enforcer plugin immutability."
    echo "Only operates on: $TARGET"
    exit 1
    ;;
esac
