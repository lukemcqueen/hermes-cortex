# Hermes sudoers — minimal passwordless sudo for automation
# Single-file policy (2026-07-31): deployed at /etc/sudoers.d/hermes
# (the obsolete /etc/sudoers.d/hermes-security split is removed on deploy)
#
# NOTE (2026-08-05): __SUDO_USERS__ is a PLACEHOLDER. Real account names are
# PII and never committed to the public repo. deploy-sudoers.sh substitutes
# the per-host user list at deploy time (CORTEX_SUDO_USERS in the host's
# private ~/.hermes-cortex/.env; falls back to the deploying user).
#
# Fleet agents — nginx management (called by crons)
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/sbin/nginx -t
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/sbin/nginx -s reload
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/systemctl start nginx
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/systemctl stop nginx
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/systemctl restart nginx

# Fleet agents — blocked IP deploy (tight single path)
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/cp /tmp/blocked_ips.conf.new /etc/nginx/blocked_ips.conf

# Fleet agents — governance enforcement helper (2026-07-31 hardening)
# Gated inside the helper: unlock/update require --cortex-update (sanctioned)
# or --orchestrator (orchestrator Unix accounts). lock/status open to all.
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/local/sbin/hermes-plugin-lock
# Root-owned immutable blocked-IP generator (see deploy-fix-blocked-ips.sh)
# BOTH platform paths listed: Linux /usr/local/sbin, macOS /usr/local/bin.
# A path that doesn't exist on a host simply never matches — harmless dead
# entry on the other platform (macOS portability, Titus 2026-08-05).
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/local/sbin/fix-blocked-ips.py
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/local/bin/fix-blocked-ips.py

# Fleet agents — htpasswd deploy
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/cp /tmp/hermes-htpasswd /etc/nginx/.hermes-htpasswd

# Fleet agents — apt cleanup (called by system-alert-watchdog)
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/apt autoremove --purge -y
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/apt clean

# Fleet agents — read-only monitoring
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status

# Fleet agents — certbot renewal
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/certbot renew --non-interactive
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/certbot certificates

# Fleet agents — nginx log reads (blocked-IP forensics)
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/cat /var/log/nginx/access.log
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/cat /var/log/nginx/error.log

# Fleet agents — vsftpd (FTP scanner forensics)
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/journalctl -u vsftpd *
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/cat /var/log/vsftpd.log
__SUDO_USERS__ ALL=(root) NOPASSWD: /bin/cat /etc/vsftpd.conf

# Fleet agents — swap refresh (agent-swap-refresh cron)
__SUDO_USERS__ ALL=(root) NOPASSWD: /sbin/swapoff, /sbin/swapon

# Fleet agents — Linux Mint maintenance helpers (desktop hosts only;
# harmless dead entries on non-Mint hosts)
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/mintdrivers-remove-live-media
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/mintdrivers-load-broadcom-modules
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/bin/mint-refresh-cache
__SUDO_USERS__ ALL=(root) NOPASSWD: /usr/lib/linuxmint/mintUpdate/dpkg_lock_check.sh
