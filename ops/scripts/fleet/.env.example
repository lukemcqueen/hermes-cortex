# .env — Steadfaste Fleet env (fleet's HC_AGENT is optional here)
#
# Add HC_AGENT= to ~/steadfaste-fleet/.env — the ONE canonical cortex env.
# fleet talks to the Agent Bus over HTTP (host-independent — works identically
# on moses and esther hosts). Bus URL/auth come from the same .env.
#
# =============================================================================
# OPTIONAL — Default agent name
# If unset, fleet falls back to AGENT_NAME in .env, then to a
# hostname-derived guess. Never assumes "moses".
# =============================================================================
HC_AGENT=esther
