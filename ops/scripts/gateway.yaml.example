{
  "_comment": "cortex-gateway config. Copy to ~/.hermes-cortex/gateway.yaml (OUTSIDE the repo). Config comes from the CORTEX env — the ONE canonical file ~/hermes-cortex/.env. We are MIGRATING AWAY from Hermes, so the gateway must be self-sufficient. Same TELEGRAM var NAMES Hermes uses, values living in our env: TELEGRAM_BOT_TOKEN (bots[].token_ref), TELEGRAM_ALLOWED_USERS (sender allowlist — REQUIRED), TELEGRAM_HOME_CHANNEL (default delivery target — REQUIRED), GATEWAY_SECRET (REQUIRED — HMAC signing secret; the gateway refuses to start without it, since an empty key makes every signature forgeable), CORTEX_BUS_URL (or bus_url below), CORTEX_BUS_TOKEN or CORTEX_BASIC_AUTH. Optional: TELEGRAM_API_BASE. See docs/templates/cortex-gateway.service.",
  "bus_url": "https://bus.example.com:8903",
  "backends": ["hermes"],
  "bots": [
    {
      "token_ref": "TELEGRAM_BOT_TOKEN",
      "channel": "telegram",
      "initial_offset": 0,
      "routing": {
        "default": "esther",
        "overrides": {}
      }
    }
  ],
  "routing": {
    "default": "hermes",
    "overrides": {}
  }
}
