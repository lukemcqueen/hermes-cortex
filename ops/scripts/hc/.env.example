# hc.env — Hermes Cortex CLI config
#
# Copy this to ~/.hermes-cortex/hc.env and fill in your value.
# hc talks to the Agent Bus over HTTP (host-independent — works identically
# on moses and esther hosts). Bus URL/auth come from cortex-bus.conf.
#
# =============================================================================
# OPTIONAL — Default agent name
# If unset, hc falls back to AGENT_NAME in cortex-bus.conf, then to a
# hostname-derived guess. Never assumes "moses".
# =============================================================================
HC_AGENT=esther
