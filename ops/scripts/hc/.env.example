# hc.env — Hermes Cortex CLI config
#
# Copy this to ~/.hermes-cortex/hc.env and fill in your values.
# Example:
#   CP_CMD="cp ~/hermes-cortex/ops/scripts/hc/.env.example ~/.hermes-cortex/hc.env"
#
# =============================================================================
# REQUIRED — Agent Bus endpoint
# =============================================================================
# Your Agent Bus URL (port 13004 is the nginx public endpoint, 8903 is local)
# HC_BUS_URL="https://bus.example.org:13004"
#
# =============================================================================
# REQUIRED — Bus authentication
# =============================================================================
# Format: agent-name:password
# HC_BUS_AUTH="moses:your-password"
#
# =============================================================================
# OPTIONAL — Default agent name (default: moses)
# =============================================================================
# HC_AGENT="moses"
