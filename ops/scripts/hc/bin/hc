#!/usr/bin/env bash
# hc — Hermes Cortex CLI entrypoint
# Source of truth: ops/scripts/hc/bin/hc — the repo keeps the module one level up, so this
# launcher lives in bin/ where nothing is named like the command (a DIRECTORY at
# ops/scripts/hc meant `bash ops/scripts/hc` answered "Is a directory").
# Deployed FLAT to ~/.hermes-cortex/scripts/hc, module beside it, linked to ~/.local/bin/hc

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
HC_PY=""
# Beside this script is the DEPLOYED layout (scripts/hc + scripts/hc.py); one level up is
# the repo layout (ops/scripts/hc/bin/hc + ops/scripts/hc/hc.py). Both are resolved before
# any known-path fallback, so the move cannot silently pick up some other host's module.
for cand in "${SCRIPT_DIR}/hc.py" "${SCRIPT_DIR}/../hc.py"; do
    if [ -f "$cand" ]; then HC_PY="$(cd "$(dirname "$cand")" && pwd)/$(basename "$cand")"; break; fi
done

# Fall back to known installation paths
if [ -z "$HC_PY" ]; then
    for try in \
        "${HOME}/hermes-cortex/ops/scripts/hc/hc.py" \
        "${HOME}/.hermes-cortex/scripts/hc.py" \
        "${HOME}/.local/bin/hc.py"; do
        if [ -f "$try" ]; then
            HC_PY="$try"
            # Announce it: a resolver that silently picks an unrelated tree makes the run
            # look identical while a different program decides.
            echo "hc: note: no module beside $(dirname "$0") or one level up; using $try" >&2
            break
        fi
    done
fi

if [ ! -f "$HC_PY" ]; then
    echo "hc: cannot find hc.py — looked beside $(dirname "$0") and one level up" >&2
    echo "hc: run the deployed ~/.hermes-cortex/scripts/hc, or reinstall with cortex-update.sh" >&2
    exit 3
fi

exec python3 "$HC_PY" "$@"
