    rows = [ln.split("|") for ln in out.splitlines() if ln.strip()]
    if args.json:
        print(json.dumps([{"relpath": r[0], "title": r[1], "source": r[2], "updated_at": r[3]} for r in rows], indent=2))
    else:
        if not rows:
