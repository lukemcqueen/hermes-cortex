#!/usr/bin/env python3
"""
mcp-inbox-proxy — Sudo'd proxy for MCP inbox HTTPS requests.

Makes HTTPS requests using the system CA bundle and prints the response
as JSON to stdout. Runs via sudo for elevated network access.

Sudoers rule (one line):
  <agent-user> ALL=(root) NOPASSWD: /usr/local/bin/mcp-inbox-proxy

Input:  JSON object on stdin with keys:
          url     — full HTTPS URL (str, required)
          method  — HTTP method (str, default POST)
          data    — request body (str, optional)
          headers — dict of extra headers (dict, optional)

Output: JSON object on stdout with keys:
          status  — HTTP status code (int)
          body    — response body text (str)
"""
import json
import sys
import urllib.error
import urllib.request

# Read request from stdin
req_data = json.load(sys.stdin)
url = req_data.get("url", "")
method = req_data.get("method", "POST")
body = req_data.get("data")
headers = req_data.get("headers", {})

if not url:
    json.dump({"status": 0, "body": "Missing 'url' in request"}, sys.stdout)
    sys.exit(1)

# Make the request (uses system CA bundle — no mTLS client cert)
try:
    data_bytes = body.encode() if body else None
    req = urllib.request.Request(url, data=data_bytes, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=15) as resp:
        json.dump({"status": resp.status, "body": resp.read().decode(errors="replace")}, sys.stdout)
except urllib.error.HTTPError as e:
    json.dump({"status": e.code, "body": e.read().decode(errors="replace")[:500]}, sys.stdout)
except Exception as e:
    json.dump({"status": 0, "body": str(e)}, sys.stdout)
