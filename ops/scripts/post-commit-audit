#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  post-commit-audit — Git post-commit hook
#  Detects --no-verify commits by checking pre-commit sentinel.
#  Logs all no-verify events for audit.
# ─────────────────────────────────────────────────────────────
set -euo pipefail

SENTINEL="${GIT_DIR:-.git}/.pre-commit-ran"
LOGDIR="${HOME}/.hermes-cortex/state"
NO_VERIFY_LOG="${LOGDIR}/no-verify-log.json"

# Consume the reflexion token (written by reflexion-check, consumed after commit)
REFLEXION_TOKEN="${LOGDIR}/.reflexion-done"
if [[ -f "$REFLEXION_TOKEN" ]]; then
  rm -f "$REFLEXION_TOKEN"
fi

# Clean up sentinel if it exists (pre-commit ran normally)
if [[ -f "$SENTINEL" ]]; then
  rm -f "$SENTINEL"
  exit 0
fi

# Sentinel missing = pre-commit hook did not run. Two causes:
#   1. Genuine `git commit --no-verify` → MUST log (audit trail)
#   2. Git-internal replay (rebase/cherry-pick/revert/merge/pull) which
#      NEVER runs pre-commit → false positive, must NOT log
# Discriminator: the HEAD reflog message. Every genuine `git commit`
# invocation (with or without --no-verify, with or without --amend, with
# --fixup/--squash) writes a reflog starting with "commit":
#   commit: ...            (normal or --no-verify)
#   commit (amend): ...    (amend or amend --no-verify)
# Git-internal replays write something else:
#   rebase (pick|squash|reword|...): ...
#   cherry-pick: ...
#   revert: ...
#   merge <branch>: ...   /   pull ...: ...   /   Merge branch '...'
# (2026-08-04 fix: previously ANY missing sentinel was logged, so
# `git pull --rebase` false-flagged every replayed commit as --no-verify
# and pre-push blocked legitimate pushes. Verified empirically on all six
# paths before this change. The prefix is "commit" NOT "commit:" so
# amend --no-verify still logs — a real bypass must never be silenced.)
REFLOG_MSG=$(git reflog -1 --format='%gs' 2>/dev/null || echo "")
if [[ -n "$REFLOG_MSG" && "$REFLOG_MSG" != commit* ]]; then
  # Git-internal replay — pre-commit legitimately does not run here.
  # Not a governance bypass. Consume any stray sentinel and stay quiet.
  rm -f "$SENTINEL"
  exit 0
fi

# Reflog starts with "commit" and sentinel is missing → genuine --no-verify.
mkdir -p "$LOGDIR"
COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
COMMIT_MSG=$(git log -1 --format="%s" 2>/dev/null || echo "unknown")
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Append to audit log
if [[ -f "$NO_VERIFY_LOG" ]]; then
  EXISTING=$(cat "$NO_VERIFY_LOG")
else
  EXISTING="[]"
fi

echo "$EXISTING" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except:
    data = []
data.append({
    'timestamp': '$TIMESTAMP',
    'commit': '$COMMIT_HASH',
    'message': '$(echo "$COMMIT_MSG" | sed "s/'/''/g")',
    'type': 'no-verify'
})
with open('$NO_VERIFY_LOG', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true

echo "⚠️  WARNING: Commit bypassed governance (--no-verify was used)"
echo "   Commit: $COMMIT_HASH"
echo "   Logged to: $NO_VERIFY_LOG"
