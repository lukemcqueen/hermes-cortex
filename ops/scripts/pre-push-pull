#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  pre-push-pull — Git pre-push hook for rule #12
#
#  Before allowing a push, fetches origin and checks whether
#  the local branch is behind the remote. If behind, rejects
#  the push with instructions to pull --rebase first.
#
#  Prevents accidental pushes that overwrite remote commits
#  or require a separate pull-rebase cycle.
#
#  Installed by: install-score-hook.sh
#  No bypass flags — consistent with all other governance hooks.
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# ── Git hooks integrity check ─────────────────────────────
# Verify core.hooksPath points to our hooks directory.
# If it doesn't, governance hooks aren't running at all.
EXPECTED_HOOKS="${HOME}/.hermes-cortex/hooks"
ACTUAL_HOOKS=$(git config --get core.hooksPath 2>/dev/null || echo "")
if [[ -z "$ACTUAL_HOOKS" ]]; then
    echo ""
    echo "❌  Push blocked: core.hooksPath is not set — git hooks are NOT running for this repo!"
    echo "    Set it: git config core.hooksPath '${EXPECTED_HOOKS}'"
    echo ""
    exit 1
fi
ACTUAL_HOOKS_RESOLVED=$(cd "$ACTUAL_HOOKS" 2>/dev/null && pwd || echo "$ACTUAL_HOOKS")
if [[ "$ACTUAL_HOOKS_RESOLVED" != "$EXPECTED_HOOKS" ]]; then
    # Pinned-repo carve-out (same as pre-commit): pin_repos_with_own_hooks()
    # points core.hooksPath at a repo's OWN .git/hooks, and cortex-update
    # refreshes the cortex hook FILES there. Accept when the hooks dir
    # carries a cortex-managed hook; otherwise fail closed.
    _CORTEX_HOOK_PRESENT=""
    for _hook_name in pre-commit pre-push; do
        if [[ -f "${ACTUAL_HOOKS_RESOLVED}/${_hook_name}" ]] && \
           grep -q "Git .* hook" "${ACTUAL_HOOKS_RESOLVED}/${_hook_name}" 2>/dev/null; then
            _CORTEX_HOOK_PRESENT=1
            break
        fi
    done
    if [[ -z "$_CORTEX_HOOK_PRESENT" ]]; then
        echo ""
        echo "❌  Push blocked: core.hooksPath points to '${ACTUAL_HOOKS_RESOLVED}' instead of '${EXPECTED_HOOKS}'"
        echo "    Governance hooks are NOT installed for this repo."
        echo "    Fix: git config core.hooksPath '${EXPECTED_HOOKS}'"
        echo ""
        exit 1
    fi
fi

# Verify hooks are not dangling symlinks
for hook in pre-commit post-commit post-merge; do
    if [[ -L "${EXPECTED_HOOKS}/${hook}" ]]; then
        target=$(readlink "${EXPECTED_HOOKS}/${hook}")
        if [[ ! -f "$target" ]] && [[ ! -f "${EXPECTED_HOOKS}/${target}" ]] && [[ ! -f "$(dirname "${EXPECTED_HOOKS}/${hook}")/${target}" ]]; then
            echo ""
            echo "❌  Push blocked: hook '${hook}' is a dangling symlink (→ ${target})"
            echo "    Re-run: bash ~/hermes-cortex/ops/scripts/install-score-hook.sh"
            echo ""
            exit 1
        fi
    elif [[ ! -f "${EXPECTED_HOOKS}/${hook}" ]]; then
        echo ""
        echo "❌  Push blocked: hook '${hook}' not found at ${EXPECTED_HOOKS}/${hook}"
        echo "    Re-run: bash ~/hermes-cortex/ops/scripts/install-score-hook.sh"
        echo ""
        exit 1
    fi
done

# ── Governance lock check ─────────────────────────────────
# Before allowing a push, verify an active governance lock exists.
GOVERNANCE_STATE_DIR="${HOME}/.hermes-cortex/state"
REPO_SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo 'generic')" 2>/dev/null || echo 'generic')
LOCK_FOUND=0
if [[ -d "$GOVERNANCE_STATE_DIR" ]]; then
  for lock_file in "$GOVERNANCE_STATE_DIR"/.governance-*.json; do
    [[ -f "$lock_file" ]] || continue
    FILE_SLUG=$(python3 -c "
import json
try:
    d = json.load(open('$lock_file'))
    slug = d.get('repo_slug')
    print(slug if slug else '$REPO_SLUG')
except Exception:
    _ = None  # expected: empty/malformed lock file
" 2>/dev/null)
    if [[ "$FILE_SLUG" == "$REPO_SLUG" ]]; then
      LOCK_FOUND=1
      break
    fi
  done
fi

if [[ "$LOCK_FOUND" -eq 0 ]]; then
  # ── Sanctioned pipeline push exception ──────────────────
  # The nginx-threat-pipeline (no_agent cron) commits with messages
  # 'auto: ... [pipeline]' touching only the blocklist allowlist, and
  # pre-commit already gated those commits (append-only + adversarial +
  # scoring). A push whose ENTIRE local-only range is sanctioned pipeline
  # commits may proceed without a governance lock. Anything else (or an
  # empty range) requires the lock exactly as before. (2026-08-05)
  _PIPE_RANGE=$(git rev-list origin/main..HEAD 2>/dev/null || true)
  if [[ -n "$_PIPE_RANGE" ]]; then
    _PIPE_ONLY=1
    while IFS= read -r _pc; do
      [[ -n "$_pc" ]] || continue
      _pmsg=$(git log -1 --format='%s' "$_pc" 2>/dev/null || echo "")
      case "$_pmsg" in
        auto:*\[pipeline\]*) : ;;
        *) _PIPE_ONLY=0; break ;;
      esac
    done <<< "$_PIPE_RANGE"
    if [[ "$_PIPE_ONLY" == "1" ]]; then
      LOCK_FOUND=1
    fi
  fi
fi

if [[ "$LOCK_FOUND" -eq 0 ]]; then
  echo ""
  echo "❌  Push blocked: no active governance lock for this repository."
  echo "    No bypass flags available — call begin_change() before making changes, then push."
  echo "    The lock file must exist at ~/.hermes-cortex/state/.governance-*.json"
  echo "    with repo_slug='$REPO_SLUG'."
  echo ""
  exit 1
fi

# ── Changed-files syntax check ────────────────────────────
# Structural verification: parse every changed file at push time.
# Unlike a marker file, this cannot be skipped or faked — the hook
# runs the checker itself and blocks on failures.
CHANGED_FILES=$(git diff HEAD --name-only --diff-filter=ACMR 2>/dev/null || true)
SYNTAX_FAILED=0
if [[ -n "$CHANGED_FILES" ]]; then
  while IFS= read -r cf; do
    case "$cf" in
      *.py)
        if ! python3 -c "import py_compile; py_compile.compile('$cf', doraise=True)" 2>/dev/null; then
          echo "  ❌ $cf — syntax error" >&2
          python3 -c "import py_compile; py_compile.compile('$cf', doraise=True)" 2>&1 | sed 's/^/    /' >&2 || true
          SYNTAX_FAILED=1
        fi
        ;;
      *.sh)
        if ! bash -n "$cf" 2>/dev/null; then
          echo "  ❌ $cf — shell syntax error" >&2
          bash -n "$cf" 2>&1 | sed 's/^/    /' >&2 || true
          SYNTAX_FAILED=1
        fi
        ;;
    esac
  done <<< "$CHANGED_FILES"
fi

if [[ "$SYNTAX_FAILED" -ne 0 ]]; then
  echo ""
  echo "❌  Push blocked: syntax errors in changed files."
  echo "    Fix the errors above and retry the push."
  echo ""
  exit 1
fi

# ── Documentation coverage check ──────────────────────────
# Heuristic: if code/config files changed, at least one .md
# file should also change. Catches pushes that modify scripts
# without updating docs — can't judge quality, but forces
# agents to consciously skip doc updates rather than forget.
HAS_CODE_CHANGE=0
HAS_DOC_CHANGE=0
if [[ -n "$CHANGED_FILES" ]]; then
  while IFS= read -r cf; do
    case "$cf" in
      *.py|*.sh|*.yaml|*.yml|*.json|*.toml|*.conf|*.cfg|Dockerfile|*.plist|*.service)
        HAS_CODE_CHANGE=1 ;;
      *.md)
        HAS_DOC_CHANGE=1 ;;
    esac
  done <<< "$CHANGED_FILES"
fi

if [[ "$HAS_CODE_CHANGE" -eq 1 && "$HAS_DOC_CHANGE" -eq 0 ]]; then
  echo ""
  echo "⚠️  Push includes code/config changes but no documentation (.md) changes."
  echo "    Check: update docs + cleanup artifacts before pushing."
  echo ""
  # Soft warning — doesn't block. Hard gate would block here.
  # exit 1
fi

# Get the remote and branch being pushed
# Git passes: <local-ref> <local-sha> <remote-ref> <remote-sha>
# We read from stdin (one line per ref being pushed)
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletion pushes
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Extract branch name from ref (e.g., refs/heads/main → main)
  branch="${local_ref#refs/heads/}"
  remote_branch="${remote_ref#refs/heads/}"

  # Only check pushes to main — feature branches can be messy
  if [[ "$branch" != "main" ]]; then
    continue
  fi

  # Fetch and check
  if ! git fetch origin "$branch" 2>/dev/null; then
    echo ""
    echo "❌  pre-push-pull: git fetch failed — cannot verify remote state."
    echo "    Push blocked for safety. No bypass flags available."
    echo ""
    exit 1
  fi

  # Check if local is behind remote
  BEHIND=$(git rev-list --count "$remote_ref..HEAD" 2>/dev/null || echo "0")
  AHEAD=$(git rev-list --count "HEAD..$remote_ref" 2>/dev/null || echo "0")

  if [[ "$AHEAD" -gt 0 ]]; then
    echo ""
    echo "❌  pre-push-pull: Local branch '$branch' is $AHEAD commit(s) behind remote."
    echo "    Pull before push to avoid conflicts or lost changes:"
    echo "      git pull --rebase origin $branch"
    echo "    No bypass flags available."
    echo ""
    exit 1
  fi

  # ── No-verify commit gate ──────────────────────────────
  # Blocks pushes that include commits made with --no-verify.
  # The post-commit hook logs these events; the pre-push hook
  # catches them before code reaches the remote.
  # 2026-08-02 hardening: previously SKIPPED when remote_sha was empty
  # ("first push to new branch") — past-Moses pushed governance-destroying
  # commits to a temp-push branch (empty remote_sha → gate skipped) then
  # merged to main (7dbba626 removed core/governance/). Now a new-branch
  # push is checked against origin/main instead: any no-verify commit not
  # already on main is blocked, closing the temp-branch bypass.
  NO_VERIFY_LOG="${HOME}/.hermes-cortex/state/no-verify-log.json"
  if [[ -f "$NO_VERIFY_LOG" ]]; then
    NO_VERIFY_BLOCKED=0
    NO_VERIFY_HASHES=$(python3 -c "
import json, sys
try:
    data = json.load(open('$NO_VERIFY_LOG'))
    for entry in data:
        print(entry.get('commit', ''))
except Exception:
    _ = None  # expected: no no-verify log yet
" 2>/dev/null || true)
    if [[ -n "$NO_VERIFY_HASHES" ]]; then
      # Compare base: existing branch → remote_sha; new branch → origin/main
      if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        BASE_SHA=$(git rev-parse origin/main 2>/dev/null || echo "")
      else
        BASE_SHA="$remote_sha"
      fi
      if [[ -n "$BASE_SHA" ]]; then
        PUSH_COMMITS=$(git rev-list "$BASE_SHA..$local_sha" 2>/dev/null || true)
        if [[ -n "$PUSH_COMMITS" ]]; then
          while IFS= read -r p_commit; do
            if grep -qF "$p_commit" <<< "$NO_VERIFY_HASHES"; then
              NO_VERIFY_BLOCKED=1
              NV_MSG=$(git log -1 --format="%s" "$p_commit" 2>/dev/null || echo "unknown")
              echo ""
              echo "❌  Push blocked: commit ${p_commit::10} was made with --no-verify"
              echo "    Message: ${NV_MSG}"
              echo "    --no-verify bypasses the adversarial verify gate and all governance checks."
              echo "    Re-do the commit through the pre-commit hook."
              echo ""
            fi
          done <<< "$PUSH_COMMITS"
        fi
      fi
    fi
    if [[ "$NO_VERIFY_BLOCKED" -ne 0 ]]; then
      # ── Bypass-debt mandate (2026-08-05) ──────────────────
      # 3 consecutive --no-verify commits are tolerated; the 4th+ is
      # MANDATED — this push is blocked until a fully verified commit
      # (pre-commit hook ran, sentinel written) resets the debt to 0.
      DEBT_FILE="${HOME}/.hermes-cortex/state/bypass-debt.json"
      DEBT=0
      if [[ -f "$DEBT_FILE" ]]; then
        DEBT=$(python3 -c "
import json
try:
    d = json.load(open('$DEBT_FILE'))
    print(d.get('consecutive_no_verify', 0))
except Exception:
    print(0)
" 2>/dev/null || echo "0")
      fi
      if [[ "${DEBT:-0}" -ge 4 ]]; then
        echo ""
        echo "🚫  ESCAPE HATCH EXHAUSTED: ${DEBT} consecutive --no-verify commits."
        echo "    The 4th bypass is MANDATED — this push is BLOCKED."
        echo "    Commit the pending change WITHOUT --no-verify so the full"
        echo "    pre-commit gate runs (scoring + adversarial + append-only)."
        echo "    A verified commit resets the counter to 0; then at most 3"
        echo "    bypasses may be used again."
        echo ""
        exit 1
      fi
      exit 1
    fi
  fi
done

# ── Doctor regression check (orchestrators, hermes-cortex only) ──
# Run doctor on EVERY hermes-cortex push by an orchestrator host.
# The strongest 2026-08-04 directive (mandatory adversarial gate)
# silently doesn't apply if deployed state drifts — the only way to
# catch that at push time is to verify the full deployed state.
# Cost ~10s.
# (2026-08-05: dogfood surfaced 7b false-positive AFTER doc-only
# pushes because the gate only fired on cortex_doctor/* changes —
# closed.)
# ⚠️  SCOPE (Luke corrections 2026-08-05): this gate fires ONLY when
# (a) the push is in the hermes-cortex repo AND (b) the host is an
# orchestrator (moses/esther). Non-cortex repos (client-mwi,
# client-works, ebm-website, pinned repos, ...) must NOT run the
# hermes-cortex doctor — a failing hermes-cortex state must never
# block a client repo's push. Non-orchestrator hosts never run it.
_detect_orch() {
  local _host _home _user
  _host=$(hostname -s 2>/dev/null || echo "unknown")
  _user=$(id -un 2>/dev/null || echo "$USER")
  _home=$(getent passwd "$_user" 2>/dev/null | cut -d: -f6)
  _home="${_home:-$HOME}"
  case "$_host" in
    moses|esther)
      [[ "$_home" == "/home/$_host" ]] && return 0
      ;;
  esac
  return 1
}

DOCTOR_BLOCKED=0
CORTEX_DOCTOR="${HOME}/hermes-cortex/ops/scripts/manage/cortex-doctor.py"
CORTEX_REPO_TOP="${HOME}/hermes-cortex"
_REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [[ "$_REPO_TOP" == "$CORTEX_REPO_TOP" ]] && _detect_orch && [[ -f "$CORTEX_DOCTOR" ]]; then
  DOCTOR_OUTPUT=$(cd "${HOME}/hermes-cortex/ops/scripts/manage" && python3 cortex-doctor.py --quiet 2>&1 || true)
  # Real failure = any ❌ check line that is NOT the "Overall: FAILING"
  # summary line (counted via its own ❌). Matches on the ❌ marker, not
  # the word "FAIL" — "Overall: FAILING" would false-positive the old grep.
  # NOTE (2026-08-05): PENDING cycles are NO LONGER excluded. The doctor
  # now FAILs only on cycles from FINISHED tasks (no active lock) — the
  # current task's cycle (lock held) is INFO. So a push with leaked
  # prior-task cycles IS blocked: you cannot ship while old cycles sit
  # unscored. Luke directive: clear them during cleanup, not later.
  _DOCTOR_FAILS=$(echo "$DOCTOR_OUTPUT" | grep -E '^ *❌' | grep -vcE 'Overall: FAILING' || true)
  if [[ "${_DOCTOR_FAILS:-0}" -gt 0 ]]; then
    echo ""
    echo "❌  Push blocked: doctor reports $([ "${_DOCTOR_FAILS:-0}" -eq 1 ] && echo '1 failure' || echo "${_DOCTOR_FAILS} failures")."
    echo "    Deployed state does not match repo source (or governance drift)."
    echo "    Run doctor locally and fix all failures before pushing:"
    echo "      cd ~/hermes-cortex/ops/scripts/manage && python3 cortex-doctor.py"
    echo ""
    echo "$DOCTOR_OUTPUT" | grep -E '^ *❌' | grep -vE 'PENDING cycles|Overall: FAILING' | head -10
    echo ""
    DOCTOR_BLOCKED=1
  fi
fi

if [[ "$DOCTOR_BLOCKED" -ne 0 ]]; then
  exit 1
fi

exit 0
