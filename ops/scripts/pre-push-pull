#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  pre-push-pull — Git pre-push hook for rule #12
#
#  Before allowing a push, fetches origin and checks whether
#  the local branch is behind the remote. If behind, rejects
#  the push with instructions to pull --rebase first.
#
#  Prevents accidental pushes that overwrite remote commits
#  or require a separate pull-rebase cycle.
#
#  Installed by: install-score-hook.sh
#  No bypass flags — consistent with all other governance hooks.
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# ── Governance lock check ─────────────────────────────────
# Before allowing a push, verify an active governance lock exists.
GOVERNANCE_STATE_DIR="${HOME}/.hermes-cortex/state"
REPO_SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo 'generic')" 2>/dev/null || echo 'generic')
LOCK_FOUND=0
if [[ -d "$GOVERNANCE_STATE_DIR" ]]; then
  for lock_file in "$GOVERNANCE_STATE_DIR"/.governance-*.json; do
    [[ -f "$lock_file" ]] || continue
    FILE_SLUG=$(python3 -c "
import json
try:
    d = json.load(open('$lock_file'))
    slug = d.get('repo_slug')
    print(slug if slug else '$REPO_SLUG')
except:
    print('')
" 2>/dev/null)
    if [[ "$FILE_SLUG" == "$REPO_SLUG" ]]; then
      LOCK_FOUND=1
      break
    fi
  done
fi

if [[ "$LOCK_FOUND" -eq 0 ]]; then
  echo ""
  echo "❌  Push blocked: no active governance lock for this repository."
  echo "    No bypass flags available — call begin_change() before making changes, then push."
  echo "    The lock file must exist at ~/.hermes-cortex/state/.governance-*.json"
  echo "    with repo_slug='$REPO_SLUG'."
  echo ""
  exit 1
fi

# ── Changed-files syntax check ────────────────────────────
# Structural verification: parse every changed file at push time.
# Unlike a marker file, this cannot be skipped or faked — the hook
# runs the checker itself and blocks on failures.
CHANGED_FILES=$(git diff HEAD --name-only --diff-filter=ACMR 2>/dev/null || true)
SYNTAX_FAILED=0
if [[ -n "$CHANGED_FILES" ]]; then
  while IFS= read -r cf; do
    case "$cf" in
      *.py)
        if ! python3 -c "import py_compile; py_compile.compile('$cf', doraise=True)" 2>/dev/null; then
          echo "  ❌ $cf — syntax error" >&2
          python3 -c "import py_compile; py_compile.compile('$cf', doraise=True)" 2>&1 | sed 's/^/    /' >&2 || true
          SYNTAX_FAILED=1
        fi
        ;;
      *.sh)
        if ! bash -n "$cf" 2>/dev/null; then
          echo "  ❌ $cf — shell syntax error" >&2
          bash -n "$cf" 2>&1 | sed 's/^/    /' >&2 || true
          SYNTAX_FAILED=1
        fi
        ;;
    esac
  done <<< "$CHANGED_FILES"
fi

if [[ "$SYNTAX_FAILED" -ne 0 ]]; then
  echo ""
  echo "❌  Push blocked: syntax errors in changed files."
  echo "    Fix the errors above and retry the push."
  echo ""
  exit 1
fi

# ── Documentation coverage check ──────────────────────────
# Heuristic: if code/config files changed, at least one .md
# file should also change. Catches pushes that modify scripts
# without updating docs — can't judge quality, but forces
# agents to consciously skip doc updates rather than forget.
HAS_CODE_CHANGE=0
HAS_DOC_CHANGE=0
if [[ -n "$CHANGED_FILES" ]]; then
  while IFS= read -r cf; do
    case "$cf" in
      *.py|*.sh|*.yaml|*.yml|*.json|*.toml|*.conf|*.cfg|Dockerfile|*.plist|*.service)
        HAS_CODE_CHANGE=1 ;;
      *.md)
        HAS_DOC_CHANGE=1 ;;
    esac
  done <<< "$CHANGED_FILES"
fi

if [[ "$HAS_CODE_CHANGE" -eq 1 && "$HAS_DOC_CHANGE" -eq 0 ]]; then
  echo ""
  echo "⚠️  Push includes code/config changes but no documentation (.md) changes."
  echo "    If this change affects other agents, update the relevant docs."
  echo "    Use --no-verify to bypass this warning for legitimate cases."
  echo ""
  # Soft warning — doesn't block. Hard gate would block here.
  # exit 1
fi

# Get the remote and branch being pushed
# Git passes: <local-ref> <local-sha> <remote-ref> <remote-sha>
# We read from stdin (one line per ref being pushed)
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletion pushes
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Extract branch name from ref (e.g., refs/heads/main → main)
  branch="${local_ref#refs/heads/}"
  remote_branch="${remote_ref#refs/heads/}"

  # Only check pushes to main — feature branches can be messy
  if [[ "$branch" != "main" ]]; then
    continue
  fi

  # Fetch and check
  if ! git fetch origin "$branch" 2>/dev/null; then
    echo ""
    echo "❌  pre-push-pull: git fetch failed — cannot verify remote state."
    echo "    Push blocked for safety. No bypass flags available."
    echo ""
    exit 1
  fi

  # Check if local is behind remote
  BEHIND=$(git rev-list --count "$remote_ref..HEAD" 2>/dev/null || echo "0")
  AHEAD=$(git rev-list --count "HEAD..$remote_ref" 2>/dev/null || echo "0")

  if [[ "$AHEAD" -gt 0 ]]; then
    echo ""
    echo "❌  pre-push-pull: Local branch '$branch' is $AHEAD commit(s) behind remote."
    echo "    Pull before push to avoid conflicts or lost changes:"
    echo "      git pull --rebase origin $branch"
    echo "    No bypass flags available."
    echo ""
    exit 1
  fi
done

exit 0
