#!/usr/bin/env bash
# Git prepare-commit-msg hook — Cortex SESSION trailer (A1 of the session-scoped review window).
#
# WHY: the close review's window is time-based (`lock.started_at`..HEAD) and narrowed by git
# AUTHOR — but one host has ONE git identity, so two sessions of the same agent cannot be told
# apart: a peer session's commit landed in the review material and refused its neighbour's close on
# files it never touched (Titus, 2026-10-19). This hook stamps the commit with the session that
# MADE it, read from the LIVE governance lock file — never from an env var the agent can export,
# so the trailer cannot be forged from prose.
#
# CONTRACT (deliberate):
#   * NEVER blocks a commit — every path ends `exit 0`. This hook runs in EVERY repo on the host
#     (global core.hooksPath), including repos with no cortex tree and no lock.
#   * No lock for THIS repo, no python3, no writable message file ⇒ do nothing.
#   * ANY pre-existing `Cortex-Session:` line is REMOVED and exactly one authoritative trailer is
#     appended, so a hand-written trailer cannot survive a governed commit.
#   * Idempotent: re-running (amend, retry) produces a byte-identical message.
#
# args: $1 = message file, $2 = source (message|template|merge|squash|commit), $3 = sha (amend)
set -uo pipefail

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ] || [ ! -w "$MSG_FILE" ]; then
  exit 0
fi

DEPLOY_HOME="${CORTEX_DEPLOY_HOME:-$HOME/.hermes-cortex}"
STATE_DIR="$DEPLOY_HOME/state"
[ -d "$STATE_DIR" ] || exit 0

if ! command -v git >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0

# The live lock for THIS repo. Several locks can be live at once (one per repo, and — the case that
# broke attribution — TWO sessions in ONE repo), so the match is on the RESOLVED repo path, never on
# the file name or the slug alone.
#
# FAIL CLOSED ON AMBIGUITY: with two live locks for this repo the hook cannot know which session is
# committing — git carries no session identity, and picking one of them is a WRONG attribution, not a
# guess: every commit gets stamped with the same id, so the close's session filter (which excludes a
# DIFFERENT id) becomes inert, and the OTHER session could read these commits as its own. Measured
# 2026-10-19 on a host running two sessions in one repo, where five consecutive commits all carried
# the same trailer. So: exactly ONE matching lock ⇒ stamp it; zero or several ⇒ write NOTHING, and
# let the review window fail closed (a missing trailer keeps a commit IN scope).
# The selection python runs with a PLAIN REDIRECT, never inside `$( ... )`.
#
# A heredoc nested inside a command substitution is a bash 3.2 parser trap: an
# apostrophe anywhere in the body (a comment saying "this session's activity" is
# enough) makes 3.2 mis-count the quotes and fail to parse the WHOLE hook — syntax
# error, non-zero exit, and `git commit` aborts. bash 5.x on Linux parses it fine,
# so it shipped clean here and broke every commit on macOS (Titus, 2026-10-20).
# Removing the apostrophe would have left the landmine armed; the fix is to not put
# a heredoc inside `$()` at all. tests/test_shell_portability.py enforces that rule.
_SESSION_OUT="$(mktemp "${TMPDIR:-/tmp}/cortex-session.XXXXXX" 2>/dev/null)" || exit 0
python3 - "$STATE_DIR" "$REPO_ROOT" "${CORTEX_SESSION_ACTIVE_TTL:-90}" <<'PY' >"$_SESSION_OUT" 2>/dev/null || true
import glob, json, os, sys, time

state_dir, repo, ttl = sys.argv[1], os.path.realpath(sys.argv[2]), float(sys.argv[3])
candidates, fresh = set(), set()
for path in sorted(glob.glob(os.path.join(state_dir, ".governance-*.json"))):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            rec = json.load(fh)
    except Exception:
        continue
    if not isinstance(rec, dict):
        continue
    lock_repo = rec.get("repo_path") or ""
    if not lock_repo or os.path.realpath(lock_repo) != repo:
        continue
    session = str(rec.get("session_id") or "").strip()
    if not session:
        continue
    candidates.add(session)
    # The lock file is REWRITTEN by the server on every governed call (heartbeat
    # refresh), so its mtime is the last governed activity for that session — the only
    # per-session signal available at commit time. It DISAMBIGUATES, it does not decide
    # on its own.
    try:
        if (time.time() - os.path.getmtime(path)) <= ttl:
            fresh.add(session)
    except OSError:
        pass
if len(fresh) == 1:
    print(fresh.pop())
elif not fresh and len(candidates) == 1:
    print(candidates.pop())
PY
SESSION="$(sed -n '1p' "$_SESSION_OUT" 2>/dev/null | tr -d '[:space:]')"
rm -f "$_SESSION_OUT"
[ -n "$SESSION" ] || exit 0

python3 - "$MSG_FILE" "$SESSION" <<'PY' 2>/dev/null || true
import re, sys

path, session = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
except OSError:
    sys.exit(0)
body = "\n".join(
    line for line in text.splitlines()
    if not re.match(r"^\s*Cortex-Session\s*:", line, re.IGNORECASE)
).rstrip()
try:
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(f"{body}\n\nCortex-Session: {session}\n")
except OSError:
    pass
PY

exit 0
