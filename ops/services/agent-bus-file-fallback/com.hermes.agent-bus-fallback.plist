<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.agent-inbox</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.hermes/hermes-agent/venv/bin/uvicorn</string>
        <string>--app-dir</string>
        <string>$HOME/hermes-cortex/ops/services/agent-inbox</string>
        <string>server:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8904</string>
        <string>--no-access-log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$HOME/hermes-cortex/ops/services/agent-inbox</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/.hermes-cortex/agent-inbox/server.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/.hermes-cortex/agent-inbox/server.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$HOME/.hermes/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
