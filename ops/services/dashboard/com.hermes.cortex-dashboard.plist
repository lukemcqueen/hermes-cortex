<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.cortex-dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/luke/.hermes-cortex/dashboard/venv/bin/python3</string>
        <string>/Users/luke/.hermes-cortex/dashboard/server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/luke/.hermes-cortex/dashboard</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANGFUSE_EXTERNAL</key>
        <string>https://your-domain.com:13002</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/luke/.hermes-cortex/logs/cortex-dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/luke/.hermes-cortex/logs/cortex-dashboard.log</string>
</dict>
</plist>
