{
  "version": 3,
  "description": "Agent registry for Hermes Cortex. health_method: 'http' for server agents with reachable health endpoints, 'inbox' for client-only agents that push via inbox.",
  "health_vector_map": [
    "resources", "services", "no_errored_crons", "no_stale_crons",
    "nginx", "ollama", "gbrain", "disk_ok", "gbrain_sources_ok"
  ],
  "routing": {
    "broadcast_topics": [
      "luke",
      "all",
      "general"
    ],
    "agent_prefix_topics": true
  },
  "agents": {
    "moses": {
      "name": "Moses",
      "role": "orchestrator",
      "host": "192.168.1.100",
      "hostname": "orchestrator-1",
      "is_server": true,
      "is_orchestrator": true,
      "accessible": true,
      "health_method": "http",
      "health_url": "http://127.0.0.1:13007/health",
      "port_range": "13001-13099",
      "description": "Moses — orchestrator server",
      "inbox_user": "moses",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    },
    "gisu": {
      "name": "Gisu",
      "role": "operations",
      "hostname": "worker-1",
      "is_server": true,
      "accessible": true,
      "health_method": "http",
      "description": "Gisu — operations server (set health_url locally, port 13007)",
      "inbox_user": "gisu",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    },
    "joseph": {
      "name": "Joseph",
      "role": "web-infrastructure",
      "hostname": "worker-2",
      "is_server": true,
      "accessible": true,
      "health_method": "http",
      "description": "Joseph — web/infra server (set health_url locally, port 12007)",
      "inbox_user": "joseph",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    },
    "kustos": {
      "name": "k",
      "role": "security",
      "hostname": "worker-3",
      "is_server": true,
      "accessible": true,
      "health_method": "http",
      "description": "k — security server (set health_url locally, port 13007)",
      "inbox_user": "kustos",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    },
    "titus": {
      "name": "Titus",
      "role": "developer",
      "hostname": "LAM2",
      "is_server": false,
      "is_client": true,
      "accessible": true,
      "health_method": "inbox",
      "platform": "macOS",
      "description": "Titus — macOS developer machine. NOT a server — do not poll. Pushes health vector to inbox using health-vector-push.sh.",
      "inbox_user": "titus",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    },
    "esther": {
      "name": "Esther",
      "role": "orchestrator-backup",
      "hostname": "worker-5",
      "is_server": true,
      "is_backup_orchestrator": true,
      "accessible": true,
      "platform": "linux",
      "health_method": "http",
      "description": "Esther — backup orchestrator, sustainability & materials expert (set health_url locally, port 14007)",
      "inbox_user": "esther",
      "inbox_watch_schedule": "every 10m",
      "inbox_deliver": "local"
    }
  }
}