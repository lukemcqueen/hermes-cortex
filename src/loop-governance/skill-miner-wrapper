#!/usr/bin/env bash
# skill-miner — wrapper for skill_miner.py
# Invokes the skill_miner.py script with all arguments passed through.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_MINER_PY="${SCRIPT_DIR}/skill_miner.py"

if [[ ! -f "${SKILL_MINER_PY}" ]]; then
  echo "ERROR: skill_miner.py not found at ${SKILL_MINER_PY}" >&2
  exit 1
fi

exec python3 "${SKILL_MINER_PY}" "$@"