<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.health-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/.hermes/agent-inbox/venv/bin/python3</string>
        <string>$HOME/.hermes/scripts/health-server.py</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/.hermes/health-server/server.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/.hermes/health-server/server.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$HOME/.hermes/agent-inbox/venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HEALTH_SERVER_NAME</key>
        <string>auto</string>
        <key>HEALTH_PORT</key>
        <string>8905</string>
    </dict>
</dict>
</plist>
