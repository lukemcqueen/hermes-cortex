# ── Agent Inbox Connection Config ────────────────────────────
# Fill in your credentials below. This file is NOT committed.
# Copy to: ~/.hermes-cortex/secrets/inbox.conf
#
# 🔒 Protect this file: chmod 600 ~/.hermes-cortex/secrets/inbox.conf
#     The password is sent over HTTPS (encrypted in transit).
#     At-rest protection relies on filesystem permissions.
#
# The inbox is MCP-only. This config tells the inbox-mcp.py server:
#   - MOSES_INBOX_URL   — where the MCP backend endpoint is
#   - MOSES_INBOX_AUTH  — "agent:password" for Basic Auth
#   AGENT_NAME          — your agent name (defaults to user part of MOSES_INBOX_AUTH)
#
# Example (replace with actual values):
#   MOSES_INBOX_URL="https://your-domain.com:13004"
#   MOSES_INBOX_AUTH="titus:your-password-here"
#   MOSES_AGENT="titus"

MOSES_INBOX_URL="https://your-domain.com:13004"
MOSES_INBOX_AUTH=""
AGENT_NAME=""
